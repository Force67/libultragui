// examples/lottie_demo/main.cc: shows four Lottie animations side by side.
//
//   ultragui_lottie_demo [font_path]
//
// The C++ bakes ULTRAGUI_SHADER_DIR and ULTRAGUI_LOTTIE_DEMO_DIR into the
// program; here both are found from this package's directory (the shaders
// are ultragui_vulkan/shaders, byte-identical to the build's).
// UIContext::LoadLottie is ultragui_lottie::lottie_ui::load_lottie, which
// returns a LottieId; `lottie_var(ui, id)` is the C++ LottieAnimation*. The
// C++ UIContext has the Lua runtime linked; nothing here runs a script, so
// the port uses NoScript.

module ultragui_lottie_demo;

import {eprintln, println} from akikit::logging;
import {arguments} from akikit::process::command_line;
import {Command} from akikit::process::child;
import {output} from akikit::process::capture;
import {get_environment_variable} from akikit::process::environment_variables;
import {path_exists} from akikit::filesystem::file_util;
import {String, from_str} from akikit::strings::string;
import {Color} from ultragui::core::color;
import {NoScript} from ultragui::scripting::script_runtime;
import {kInvalidFont} from ultragui::text::text_engine;
import {UIConfig, UIContext} from ultragui::ui_context;
import {set_image_texture} from ultragui::widgets::image;
import {GlfwPlatform} from ultragui_glfw::platform_glfw;
import {VulkanRhi} from ultragui_vulkan::vulkan_rhi;
import {LottieId, load_lottie, lottie_var} from ultragui_lottie::lottie_ui;

// find_font: $ULTRAGUI_FONT if it exists, else what fc-match names (its
// first line, as fgets reads it, without the trailing newline) if it exists.
fn find_font(): String? {
  if (let env = get_environment_variable("ULTRAGUI_FONT")) {
    if (path_exists(env.as_str())) {
      return env;
    }
  }
  var cmd = Command("sh");
  cmd.arg("-c");
  cmd.arg("fc-match -f '%{file}' 'sans:style=Regular' 2>/dev/null");
  let out = output(cmd) else {
    return none;
  };
  var n: usize = 0;
  while (n < out.stdout.len() && n < 1023) {
    n += 1;
    if (out.stdout[n - 1] == 0x0A) {
      break;
    }
  }
  while (n > 0 && (out.stdout[n - 1] == 0x0A || out.stdout[n - 1] == 0x0D)) {
    n -= 1;
  }
  if (n == 0) {
    return none;
  }
  var path = String();
  if (!path.push_utf8(out.stdout.as_slice()[..n] as bytes)) {
    return none;
  }
  return path_exists(path.as_str()) ? path : none;
}

struct AnimInfo : Copy {
  pub let file: str<'static>
  pub let label: str<'static>
  pub let widget_name: str<'static>
  pub let label_name: str<'static>
}

static let kAnims: [AnimInfo; 4] = [
  AnimInfo { file: "anims/spinner.json", label: "Spinner", widget_name: "img_spinner", label_name: "lbl_spinner" },
  AnimInfo { file: "anims/pulse.json", label: "Pulse", widget_name: "img_pulse", label_name: "lbl_pulse" },
  AnimInfo { file: "anims/bounce.json", label: "Bounce", widget_name: "img_bounce", label_name: "lbl_bounce" },
  AnimInfo { file: "anims/wave.json", label: "Wave", widget_name: "img_wave", label_name: "lbl_wave" },
];

// Layout built in code (no .ugui file needed)
comptime let kLayout: str = r"""
panel root {
    layout: column;
    width: 100vw;
    height: 100vh;
    padding: 40;
    gap: 30;
    background: #0f0f1a;
    align: center;

    text title {
        text: "Lottie Animation Demo";
        font-size: 28;
        color: #e0e0ff;
        text-align: center;
        letter-spacing: 2;
    }

    text subtitle {
        text: "Hand-crafted Lottie JSON rendered by rlottie";
        font-size: 14;
        color: #606080;
        text-align: center;
    }

    panel row {
        layout: row;
        justify: center;
        gap: 30;
        flex-grow: 1;
        align: center;

        panel card_spinner {
            layout: column;
            align: center;
            gap: 12;
            padding: 24;
            background: #1a1a2e;
            corner-radius: 16;
            border-color: #2a2a50;
            border-width: 1;
            shadow-color: #00000040;
            shadow-blur: 12;
            shadow-y: 4;

            image img_spinner { width: 128; height: 128; }
            text lbl_spinner { text: "Spinner"; font-size: 13; color: #8888aa; text-align: center; }
        }

        panel card_pulse {
            layout: column;
            align: center;
            gap: 12;
            padding: 24;
            background: #1a1a2e;
            corner-radius: 16;
            border-color: #2a2a50;
            border-width: 1;
            shadow-color: #00000040;
            shadow-blur: 12;
            shadow-y: 4;

            image img_pulse { width: 128; height: 128; }
            text lbl_pulse { text: "Pulse"; font-size: 13; color: #8888aa; text-align: center; }
        }

        panel card_bounce {
            layout: column;
            align: center;
            gap: 12;
            padding: 24;
            background: #1a1a2e;
            corner-radius: 16;
            border-color: #2a2a50;
            border-width: 1;
            shadow-color: #00000040;
            shadow-blur: 12;
            shadow-y: 4;

            image img_bounce { width: 128; height: 128; }
            text lbl_bounce { text: "Bounce"; font-size: 13; color: #8888aa; text-align: center; }
        }

        panel card_wave {
            layout: column;
            align: center;
            gap: 12;
            padding: 24;
            background: #1a1a2e;
            corner-radius: 16;
            border-color: #2a2a50;
            border-width: 1;
            shadow-color: #00000040;
            shadow-blur: 12;
            shadow-y: 4;

            image img_wave { width: 128; height: 128; }
            text lbl_wave { text: "Wave"; font-size: 13; color: #8888aa; text-align: center; }
        }
    }

    text footer {
        text: "All animations are Lottie JSON files rendered on-the-fly via rlottie";
        font-size: 12;
        color: #404060;
        text-align: center;
    }
}
""";

pub fn main(): i32 {
  let args = arguments();
  let font_path = args.len() > 0 ? from_str(args[0]) : find_font() else {
    eprintln("No font found. Set ULTRAGUI_FONT or pass a path.");
    return 1;
  };

  let config = UIConfig {
    title: from_str("ultragui: Lottie Demo"),
    width: 900,
    height: 520,
    clear_color: Color::from_hex(0x0f0f1a),
    shader_dir: from_str(f"{@package_dir()}/../../ultragui_vulkan/shaders"),
  };

  var ui = UIContext::<GlfwPlatform, VulkanRhi, NoScript>(GlfwPlatform(), VulkanRhi(), NoScript());
  if (!ui.init(config)) {
    return 1;
  }

  let font = ui.load_font(font_path.as_str());
  if (font == kInvalidFont) {
    ui.shutdown();
    return 1;
  }
  ui.set_default_font(font);

  // Load layout
  let _ = ui.load_ui_string(kLayout, "lottie_demo");

  // Load Lottie animations and attach to Image widgets
  let base = f"{@package_dir()}/../../../examples/lottie_demo";
  var loaded: [LottieId?; 4] = [none, none, none, none];

  for (let i in 0usize..4) {
    let info = kAnims[i];
    let path = f"{base}/{info.file}";
    if (let id = load_lottie(ui, path.as_str(), 128, 128)) {
      var tex = 0u64;
      var duration = 0.0f64;
      var frames = 0u32;
      var fps = 0.0f64;
      if (var anim& = lottie_var(ui, id)) {
        anim.play();
        anim.set_loop(true);
        tex = anim.texture();
        duration = anim.duration();
        frames = anim.total_frames();
        fps = anim.frame_rate();
      }
      let w = ui.find_widget(info.widget_name);
      set_image_texture(ui.world, w, tex, 128.0, 128.0);
      loaded[i] = id;
      println(f"Loaded: {info.label} ({duration:.1f}s, {frames} frames @ {fps:.0f} fps)");
    } else {
      eprintln(f"Failed to load: {path}");
    }
  }

  // Main loop: UIContext auto-updates all Lottie animations
  while (ui.running()) {
    // Re-attach textures each frame since the pixel data updates in-place
    // (the texture handle is stable, but the Image widget needs to know)
    for (let i in 0usize..4) {
      let id = loaded[i] else {
        continue;
      };
      let tex = lottie_var(ui, id)!.texture();
      let w = ui.find_widget(kAnims[i].widget_name);
      set_image_texture(ui.world, w, tex, 128.0, 128.0);
    }
    ui.update();
  }

  ui.shutdown();
  return 0;
}
