// examples/embed_vulkan/main.cc: embedding sample (Dear ImGui style). The
// host creates the Vulkan instance, device, swapchain, render pass and
// command buffers and drives presentation; ultragui runs in draw-data mode
// (RenderDrawData builds a draw list, no RHI) and the ugui_impl_vulkan
// backend (VulkanBackend) records it into the host's command buffer inside
// the host's render pass.
//
// Shape differences (not behavior):
// * The C++ keeps the host state in a file-static `Vk`; here it is a Host
//   value (the same code as ultragui_vulkan/examples/embed_scene).
// * `ugui::vk` is a file-static backend in the C++; here the host keeps a
//   boxed VulkanBackend and hands UIContext a forwarding view of it
//   (SharedTextures), where the C++ hands it vk::texture_backend().
// * The C++ bakes ULTRAGUI_SHADER_DIR; the shaders here are the
//   byte-identical copies in ultragui_vulkan/shaders.
// * The click lambda compares the clicked widget with the one named
//   btn_hello, looked up once (router handlers get no World here).
// * RenderDrawData's list is read back with `ui.renderer.get_draw_data()`
//   where the backend records it (the same buffers). The UIContext's Rhi
//   type is NullRhi (draw-data mode never initializes one); nothing here
//   runs a script, so the runtime is NoScript.

module ultragui_embed_vulkan;

import {List, filled} from akikit::containers::list;
import {eprintln, println} from akikit::logging;
import {Command} from akikit::process::child;
import {output} from akikit::process::capture;
import {exit} from akikit::process::process;
import {path_exists} from akikit::filesystem::file_util;
import {Box} from akikit::memory::box;
import {String, from_str} from akikit::strings::string;
import {Atomic} from akikit::threading::atomic;
import {WidgetId} from ultragui::core::handle;
import {MouseButton} from ultragui::input::input_queue;
import {TextureId} from ultragui::render::draw_data;
import {TextureBackend, TextureBackendBox} from ultragui::render::texture_backend;
import {NullRhi} from ultragui::rhi::null_rhi;
import {RhiFilter, RhiFormat} from ultragui::rhi::rhi_types;
import {NoScript} from ultragui::scripting::script_runtime;
import {load_svg_memory} from ultragui::svg::svg;
import {UIConfig, UIContext} from ultragui::ui_context;
import {set_image_texture} from ultragui::widgets::image;
import {GlfwPlatform} from ultragui_glfw::platform_glfw;
import {GlfwWindow, glfw_create_window, glfw_destroy_window, glfw_get_framebuffer_size, glfw_get_time, glfw_init,
  glfw_terminate, glfw_wait_events, glfw_window_hint, glfw_window_should_close, kGlfwClientApi, kGlfwNoApi,
} from ultragui_glfw::sys::glfw;
import {InitInfo, VulkanBackend} from ultragui_vulkan::ugui_impl_vulkan;
import * from ultragui_vulkan::sys::vulkan;

comptime let kFramesInFlight: u32 = 2;

comptime let kUi: str = r"""
panel root {
  width: 100vw; height: 100vh;
  layout: column; justify: center; align: center;
  panel card {
    layout: column; gap: 10; padding: 28; align: center;
    background: #14142899; corner-radius: 18;
    border-color: #ffffff20; border-width: 1;
    shadow-color: #00000080; shadow-blur: 28; shadow-y: 10;
    image logo { width: 72; height: 72; }
    text title { text: "ultragui via ugui_impl_vulkan"; font-size: 22; color: #ffffff; }
    text sub {
      text: "Host owns the Vulkan device, swapchain and render pass.";
      font-size: 13; color: #a8a8c8;
    }
    button btn_hello {
      text: "Click me"; background: #4a4aff; color: #ffffff;
      corner-radius: 8; padding: 10 20; cursor: pointer;
    }
  }
}
""";

comptime let kLogoSvg: str = r"""
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
  <circle cx="50" cy="50" r="46" fill="#4a4aff"/>
  <circle cx="50" cy="50" r="46" fill="none" stroke="#ffffff" stroke-width="4"/>
  <rect x="30" y="30" width="40" height="40" rx="8" fill="#ffffff"/>
</svg>
""";

// FindFont: what fc-match prints (all of it, as fread reads it) if that file
// exists, else the first existing candidate.
fn find_font(): String? {
  var cmd = Command("sh");
  cmd.arg("-c");
  cmd.arg("fc-match -f '%{file}' sans 2>/dev/null");
  if (let out = output(cmd)) {
    let n = out.stdout.len() < 1023 ? out.stdout.len() : 1023;
    var path = String();
    if (n > 0 && path.push_utf8(out.stdout.as_slice()[..n] as bytes) && path_exists(path.as_str())) {
      return path;
    }
  }
  let candidates = [
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "/usr/share/fonts/TTF/DejaVuSans.ttf",
    "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
    "/usr/share/fonts/liberation/LiberationSans-Regular.ttf",
    "/System/Library/Fonts/Helvetica.ttc",
  ];
  for (let c in candidates) {
    if (path_exists(c)) {
      return from_str(c);
    }
  }
  return none;
}

fn die(msg: str) {
  eprintln(f"embed_vulkan: {msg}");
  exit(1);
}

fn vkcheck(r: VkResult, what: str) {
  if (r != kVkSuccess) {
    die(what);
  }
}

// vk::texture_backend() as UIContext holds it: a view of the host's boxed
// backend, which outlives the UIContext's use of it.
struct SharedTextures : TextureBackend {
  pub unowned var backend: *var VulkanBackend

  pub fn create_texture(var self&, width: u32, height: u32, format: RhiFormat, pixels: bytes, filter: RhiFilter): TextureId =>
    unsafe (*self.backend).create_texture(width, height, format, pixels, filter);
  pub fn update_texture(var self&, id: TextureId, pixels: bytes) {
    unsafe (*self.backend).update_texture(id, pixels);
  }
  pub fn destroy_texture(var self&, id: TextureId) {
    unsafe (*self.backend).destroy_texture(id);
  }
}

// The host's Vulkan state (embed_vulkan's `Vk`).
struct Host {
  pub unowned var instance: VkInstance = null
  pub var surface: VkSurfaceKHR = 0
  pub unowned var phys: VkPhysicalDevice = null
  pub var qfam: u32 = 0
  pub unowned var device: VkDevice = null
  pub unowned var queue: VkQueue = null
  pub var format: VkSurfaceFormatKHR = VkSurfaceFormatKHR {}
  pub var render_pass: VkRenderPass = 0
  pub var cmd_pool: VkCommandPool = 0
  pub var desc_pool: VkDescriptorPool = 0
  pub var swapchain: VkSwapchainKHR = 0
  pub var extent: VkExtent2D = VkExtent2D {}
  pub var views: List<VkImageView> = List()
  pub var framebuffers: List<VkFramebuffer> = List()
  pub var render_finished: List<VkSemaphore> = List()
  pub var cmd: [VkCommandBuffer; 2] = [null; 2]
  pub var image_available: [VkSemaphore; 2] = [0; 2]
  pub var in_flight: [VkFence; 2] = [0; 2]
  pub var frame: u32 = 0
}

fn Host::create_swapchain(var self&, win: *var GlfwWindow) {
  var caps = VkSurfaceCapabilitiesKHR {};
  let _ = unsafe vk_get_physical_device_surface_capabilities_khr(self.phys, self.surface, &raw var caps);
  self.extent = caps.current_extent;
  if (self.extent.width == 0xFFFF_FFFF) {
    var w: i32 = 0;
    var h: i32 = 0;
    unsafe glfw_get_framebuffer_size(win, &raw var w, &raw var h);
    self.extent = VkExtent2D { width: w as u32, height: h as u32 };
  }
  var img_count = caps.min_image_count + 1;
  if (caps.max_image_count > 0 && img_count > caps.max_image_count) {
    img_count = caps.max_image_count;
  }

  let ci = VkSwapchainCreateInfoKHR {
    surface: self.surface,
    min_image_count: img_count,
    image_format: self.format.format,
    image_color_space: self.format.color_space,
    image_extent: self.extent,
    image_array_layers: 1,
    image_usage: kVkImageUsageColorAttachmentBit,
    image_sharing_mode: kVkSharingModeExclusive,
    pre_transform: caps.current_transform,
    composite_alpha: kVkCompositeAlphaOpaqueBitKhr,
    present_mode: kVkPresentModeFifoKhr,
    clipped: kVkTrue,
  };
  vkcheck(unsafe vk_create_swapchain_khr(self.device, &raw ci, null, &raw var self.swapchain), "vkCreateSwapchainKHR(vk.device, &ci, nullptr, &vk.swapchain)");

  var n: u32 = 0;
  let _ = unsafe vk_get_swapchain_images_khr(self.device, self.swapchain, &raw var n, null);
  var images: List<VkImage> = filled(n as usize, 0);
  let _ = unsafe vk_get_swapchain_images_khr(self.device, self.swapchain, &raw var n, @ptr(images.as_slice_var()));
  for (let i in 0..n as usize) {
    let vci = VkImageViewCreateInfo {
      image: images[i],
      view_type: kVkImageViewType2d,
      format: self.format.format,
      subresource_range: VkImageSubresourceRange { aspect_mask: kVkImageAspectColorBit, base_mip_level: 0, level_count: 1, base_array_layer: 0, layer_count: 1 },
    };
    var view: VkImageView = 0;
    vkcheck(unsafe vk_create_image_view(self.device, &raw vci, null, &raw var view), "vkCreateImageView(vk.device, &vci, nullptr, &vk.views[i])");
    self.views.push(view);
    let fci = VkFramebufferCreateInfo {
      render_pass: self.render_pass,
      attachment_count: 1,
      attachments: unsafe (&raw view),
      width: self.extent.width,
      height: self.extent.height,
      layers: 1,
    };
    var fb: VkFramebuffer = 0;
    vkcheck(unsafe vk_create_framebuffer(self.device, &raw fci, null, &raw var fb), "vkCreateFramebuffer(vk.device, &fci, nullptr, &vk.framebuffers[i])");
    self.framebuffers.push(fb);
    let sci = VkSemaphoreCreateInfo {};
    var sem: VkSemaphore = 0;
    vkcheck(unsafe vk_create_semaphore(self.device, &raw sci, null, &raw var sem), "vkCreateSemaphore(vk.device, &sci, nullptr, &vk.render_finished[i])");
    self.render_finished.push(sem);
  }
}

fn Host::destroy_swapchain(var self&) {
  unsafe {
    for (let fb in self.framebuffers) {
      vk_destroy_framebuffer(self.device, fb, null);
    }
    for (let v in self.views) {
      vk_destroy_image_view(self.device, v, null);
    }
    for (let s in self.render_finished) {
      vk_destroy_semaphore(self.device, s, null);
    }
  }
  self.framebuffers.clear();
  self.views.clear();
  self.render_finished.clear();
  if (self.swapchain != 0) {
    unsafe vk_destroy_swapchain_khr(self.device, self.swapchain, null);
  }
  self.swapchain = 0;
}

fn Host::init(var self&, win: *var GlfwWindow) {
  var ext_count: u32 = 0;
  let exts = unsafe glfw_get_required_instance_extensions(&raw var ext_count);
  let app = VkApplicationInfo { application_name: c"embed_vulkan", api_version: kVkApiVersion11 };
  let ici = VkInstanceCreateInfo {
    application_info: unsafe (&raw app),
    enabled_extension_count: ext_count,
    enabled_extension_names: unsafe (exts as *const *const c_char),
  };
  vkcheck(unsafe vk_create_instance(&raw ici, null, &raw var self.instance), "vkCreateInstance(&ici, nullptr, &vk.instance)");
  vkcheck(unsafe glfw_create_window_surface(self.instance, win, null, &raw var self.surface), "glfwCreateWindowSurface(vk.instance, win, nullptr, &vk.surface)");

  var dev_count: u32 = 0;
  let _ = unsafe vk_enumerate_physical_devices(self.instance, &raw var dev_count, null);
  var devs: List<VkPhysicalDevice> = filled(dev_count as usize, null);
  let _ = unsafe vk_enumerate_physical_devices(self.instance, &raw var dev_count, @ptr(devs.as_slice_var()));
  for (let d in devs) {
    var qn: u32 = 0;
    unsafe vk_get_physical_device_queue_family_properties(d, &raw var qn, null);
    var qprops: List<VkQueueFamilyProperties> = filled(qn as usize, VkQueueFamilyProperties {});
    unsafe vk_get_physical_device_queue_family_properties(d, &raw var qn, @ptr(qprops.as_slice_var()));
    for (let i in 0..qn) {
      var present: u32 = kVkFalse;
      let _ = unsafe vk_get_physical_device_surface_support_khr(d, i, self.surface, &raw var present);
      if ((qprops[i as usize].queue_flags & kVkQueueGraphicsBit) != 0 && present != 0) {
        self.phys = d;
        self.qfam = i;
        break;
      }
    }
    if (self.phys != null) {
      break;
    }
  }
  if (self.phys == null) {
    die("no suitable GPU");
  }

  let prio: f32 = 1.0;
  let qci = VkDeviceQueueCreateInfo { queue_family_index: self.qfam, queue_count: 1, queue_priorities: unsafe (&raw prio) };
  let dev_exts = [c"VK_KHR_swapchain"];
  let dci = VkDeviceCreateInfo {
    queue_create_info_count: 1,
    queue_create_infos: unsafe (&raw qci),
    enabled_extension_count: 1,
    enabled_extension_names: @ptr(dev_exts[..]),
  };
  vkcheck(unsafe vk_create_device(self.phys, &raw dci, null, &raw var self.device), "vkCreateDevice(vk.phys, &dci, nullptr, &vk.device)");
  unsafe vk_get_device_queue(self.device, self.qfam, 0, &raw var self.queue);

  var fmt_count: u32 = 0;
  let _ = unsafe vk_get_physical_device_surface_formats_khr(self.phys, self.surface, &raw var fmt_count, null);
  var formats: List<VkSurfaceFormatKHR> = filled(fmt_count as usize, VkSurfaceFormatKHR {});
  let _ = unsafe vk_get_physical_device_surface_formats_khr(self.phys, self.surface, &raw var fmt_count, @ptr(formats.as_slice_var()));
  self.format = formats[0];
  for (let f in formats) {
    if (f.format == kVkFormatB8g8r8a8Srgb && f.color_space == kVkColorSpaceSrgbNonlinearKhr) {
      self.format = f;
      break;
    }
  }

  let color_att = VkAttachmentDescription {
    format: self.format.format,
    samples: kVkSampleCount1Bit,
    load_op: kVkAttachmentLoadOpClear,
    store_op: kVkAttachmentStoreOpStore,
    stencil_load_op: kVkAttachmentLoadOpDontCare,
    stencil_store_op: kVkAttachmentStoreOpDontCare,
    initial_layout: kVkImageLayoutUndefined,
    final_layout: kVkImageLayoutPresentSrcKhr,
  };
  let color_ref = VkAttachmentReference { attachment: 0, layout: kVkImageLayoutColorAttachmentOptimal };
  let subpass = VkSubpassDescription {
    pipeline_bind_point: kVkPipelineBindPointGraphics,
    color_attachment_count: 1,
    color_attachments: unsafe (&raw color_ref),
  };
  let dep = VkSubpassDependency {
    src_subpass: kVkSubpassExternal,
    dst_subpass: 0,
    src_stage_mask: kVkPipelineStageColorAttachmentOutputBit,
    dst_stage_mask: kVkPipelineStageColorAttachmentOutputBit,
    dst_access_mask: kVkAccessColorAttachmentWriteBit,
  };
  let rpci = VkRenderPassCreateInfo {
    attachment_count: 1,
    attachments: unsafe (&raw color_att),
    subpass_count: 1,
    subpasses: unsafe (&raw subpass),
    dependency_count: 1,
    dependencies: unsafe (&raw dep),
  };
  vkcheck(unsafe vk_create_render_pass(self.device, &raw rpci, null, &raw var self.render_pass), "vkCreateRenderPass(vk.device, &rpci, nullptr, &vk.render_pass)");

  let pci = VkCommandPoolCreateInfo { flags: kVkCommandPoolCreateResetCommandBufferBit, queue_family_index: self.qfam };
  vkcheck(unsafe vk_create_command_pool(self.device, &raw pci, null, &raw var self.cmd_pool), "vkCreateCommandPool(vk.device, &pci, nullptr, &vk.cmd_pool)");
  let cbi = VkCommandBufferAllocateInfo { command_pool: self.cmd_pool, level: kVkCommandBufferLevelPrimary, command_buffer_count: kFramesInFlight };
  vkcheck(unsafe vk_allocate_command_buffers(self.device, &raw cbi, @ptr(self.cmd[..])), "vkAllocateCommandBuffers(vk.device, &cbi, vk.cmd)");
  for (let i in 0..kFramesInFlight as usize) {
    let sci = VkSemaphoreCreateInfo {};
    vkcheck(unsafe vk_create_semaphore(self.device, &raw sci, null, &raw var self.image_available[i]), "vkCreateSemaphore(vk.device, &sci, nullptr, &vk.image_available[i])");
    let fci = VkFenceCreateInfo { flags: kVkFenceCreateSignaledBit };
    vkcheck(unsafe vk_create_fence(self.device, &raw fci, null, &raw var self.in_flight[i]), "vkCreateFence(vk.device, &fci, nullptr, &vk.in_flight[i])");
  }

  let ps = VkDescriptorPoolSize { type_: kVkDescriptorTypeCombinedImageSampler, descriptor_count: 16 };
  let dpci = VkDescriptorPoolCreateInfo { pool_size_count: 1, pool_sizes: unsafe (&raw ps), max_sets: 16 };
  vkcheck(unsafe vk_create_descriptor_pool(self.device, &raw dpci, null, &raw var self.desc_pool), "vkCreateDescriptorPool(vk.device, &dpci, nullptr, &vk.desc_pool)");

  self.create_swapchain(win);
}

fn Host::shutdown(var self&) {
  self.destroy_swapchain();
  unsafe {
    vk_destroy_descriptor_pool(self.device, self.desc_pool, null);
    for (let i in 0..kFramesInFlight as usize) {
      vk_destroy_semaphore(self.device, self.image_available[i], null);
      vk_destroy_fence(self.device, self.in_flight[i], null);
    }
    vk_destroy_command_pool(self.device, self.cmd_pool, null);
    vk_destroy_render_pass(self.device, self.render_pass, null);
    vk_destroy_device(self.device, null);
    vk_destroy_surface_khr(self.instance, self.surface, null);
    vk_destroy_instance(self.instance, null);
  }
}


fn Host::recreate_swapchain(var self&, win: *var GlfwWindow) {
  var w: i32 = 0;
  var h: i32 = 0;
  unsafe glfw_get_framebuffer_size(win, &raw var w, &raw var h);
  while (w == 0 || h == 0) {  // minimized: wait until it has a size again
    unsafe glfw_wait_events();
    unsafe glfw_get_framebuffer_size(win, &raw var w, &raw var h);
  }
  let _ = unsafe vk_device_wait_idle(self.device);
  self.destroy_swapchain();
  self.create_swapchain(win);
}

pub fn main(): i32 {
  // --- Window (no client API: Vulkan) ---
  if (unsafe glfw_init() == 0) {
    die("glfwInit failed");
  }
  if (unsafe glfw_vulkan_supported() == 0) {
    die("Vulkan not supported by GLFW");
  }
  unsafe glfw_window_hint(kGlfwClientApi, kGlfwNoApi);
  let win = unsafe glfw_create_window(1280, 800, c"ultragui embedded (host owns Vulkan)", null, null);
  if (win == null) {
    die("window creation failed");
  }

  // --- Host Vulkan: instance, surface, device, render pass, sync ---
  var host = Host {};
  host.init(win);

  // --- ultragui: draw-data mode, attached to the host's window ---
  var ui = UIContext::<GlfwPlatform, NullRhi, NoScript>(GlfwPlatform(), NullRhi(), NoScript());
  let cfg = UIConfig { external_window: unsafe (win as *var u8), draw_data: true, width: 1280, height: 800 };
  if (!ui.init(cfg)) {
    die("ui.Init failed");
  }
  if (let font = find_font()) {
    ui.set_default_font(ui.load_font(font.as_str()));
  } else {
    eprintln("embed_vulkan: no system font found");
  }
  let _ = ui.load_ui_string(kUi, "embed");

  let button: WidgetId = ui.find_widget("btn_hello");
  let clicks = Atomic::<i32>(0);
  ui.input.set_on_click(own fn(w: WidgetId, b: MouseButton) {
    if (button.valid() && w == button) {
      let n = clicks.fetch_add(1) + 1;
      println(f"embed_vulkan: button clicked ({n})");
    }
  });

  // --- Backend: records the draw list into the host's command buffer ---
  var backend = Box(VulkanBackend());
  let bi = InitInfo {
    instance: host.instance,
    physical_device: host.phys,
    device: host.device,
    queue_family: host.qfam,
    queue: host.queue,
    descriptor_pool: host.desc_pool,
    render_pass: host.render_pass,
    frames_in_flight: kFramesInFlight,
    shader_dir: from_str(f"{@package_dir()}/../../ultragui_vulkan/shaders"),
  };
  if (!backend.get_var().init(bi)) {
    die("ugui::vk::Init failed");
  }

  // Wire the texture seam, then use it for an SVG logo.
  ui.set_texture_backend(TextureBackendBox::of(SharedTextures { backend: unsafe (backend.as_ptr() as *var VulkanBackend) }));
  {
    if (let img = load_svg_memory(kLogoSvg as bytes, 72, 72)) {
      var logo: TextureId = 0;
      if (var tex& = ui.texture_backend()) {
        logo = tex.create_texture(img.width, img.height, RhiFormat::Rgba8Unorm, img.pixels.as_slice() as bytes, RhiFilter::Linear);
      }
      let w = ui.find_widget("logo");
      set_image_texture(ui.world, w, logo, img.width as f32, img.height as f32);
    }
  }

  var font_rev: u32 = 0xFFFF_FFFF;

  while (unsafe glfw_window_should_close(win) == 0) {
    let _ = ui.render_draw_data();  // polls input, builds UI

    if (ui.text_engine.atlas_revision() != font_rev) {
      let size = ui.text_engine.atlas_size();
      let _ = backend.get_var().update_font_atlas(ui.text_engine.atlas_pixels(), size.x as u32, size.y as u32);
      font_rev = ui.text_engine.atlas_revision();
    }

    backend.get_var().new_frame();
    let fi = host.frame as usize;
    let fence = host.in_flight[fi];
    let _ = unsafe vk_wait_for_fences(host.device, 1, &raw fence, kVkTrue, 0xFFFF_FFFF_FFFF_FFFF);

    var image_index: u32 = 0;
    let acq = unsafe vk_acquire_next_image_khr(host.device, host.swapchain, 0xFFFF_FFFF_FFFF_FFFF, host.image_available[fi], 0,
      &raw var image_index);
    if (acq == kVkErrorOutOfDateKhr) {
      host.recreate_swapchain(win);
      continue;
    }
    let _ = unsafe vk_reset_fences(host.device, 1, &raw fence);

    let cb = host.cmd[fi];
    let cbbi = VkCommandBufferBeginInfo {};
    unsafe {
      let _ = vk_reset_command_buffer(cb, 0);
      let _ = vk_begin_command_buffer(cb, &raw cbbi);
    }

    // Host clear (its "scene"), then ultragui inside the same pass.
    let t = unsafe glfw_get_time() as f32;
    let clear = VkClearValue { float32: [0.05 + 0.05 * (0.5 + 0.5 * @sin(t)), 0.06, 0.10, 1.0] };
    let rbi = VkRenderPassBeginInfo {
      render_pass: host.render_pass,
      framebuffer: host.framebuffers[image_index as usize],
      render_area: VkRect2D { offset: VkOffset2D { x: 0, y: 0 }, extent: host.extent },
      clear_value_count: 1,
      clear_values: unsafe (&raw clear),
    };
    unsafe vk_cmd_begin_render_pass(cb, &raw rbi, kVkSubpassContentsInline);

    {
      let dd = ui.renderer.get_draw_data();
      backend.get_var().render_draw_data(dd, cb);
    }

    unsafe {
      vk_cmd_end_render_pass(cb);
      let _ = vk_end_command_buffer(cb);
    }

    let wait_stage: u32 = kVkPipelineStageColorAttachmentOutputBit;
    let wait_sem = host.image_available[fi];
    let signal_sem = host.render_finished[image_index as usize];
    let si = VkSubmitInfo {
      wait_semaphore_count: 1,
      wait_semaphores: unsafe (&raw wait_sem),
      wait_dst_stage_mask: unsafe (&raw wait_stage),
      command_buffer_count: 1,
      command_buffers: unsafe (&raw cb),
      signal_semaphore_count: 1,
      signal_semaphores: unsafe (&raw signal_sem),
    };
    vkcheck(unsafe vk_queue_submit(host.queue, 1, &raw si, fence), "vkQueueSubmit(vk.queue, 1, &si, vk.in_flight[fi])");

    let swapchain = host.swapchain;
    let present = VkPresentInfoKHR {
      wait_semaphore_count: 1,
      wait_semaphores: unsafe (&raw signal_sem),
      swapchain_count: 1,
      swapchains: unsafe (&raw swapchain),
      image_indices: unsafe (&raw image_index),
    };
    let pres = unsafe vk_queue_present_khr(host.queue, &raw present);
    if (pres == kVkErrorOutOfDateKhr || pres == kVkSuboptimalKhr) {
      host.recreate_swapchain(win);
    }

    host.frame = (host.frame + 1) % kFramesInFlight;
  }

  let _ = unsafe vk_device_wait_idle(host.device);
  backend.get_var().shutdown();
  ui.shutdown();
  host.shutdown();
  unsafe {
    glfw_destroy_window(win);
    glfw_terminate();
  }
  return 0;
}
