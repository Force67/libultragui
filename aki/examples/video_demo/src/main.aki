// examples/video_demo/main.cc: MPEG-1 video playback, three scenes:
//   1: basic player (single video in an Image widget)
//   2: multi-view (same texture on several widgets)
//   3: 3D cube (video texture on spinning cube faces)
//
//   ultragui_video_demo [font_path]
//
// Controls: Space play/pause, R restart, L loop, Left/Right seek 2 s, 1-3
// switch scene.
//
// Shape differences (not behavior):
// * The C++ bakes ULTRAGUI_SHADER_DIR and ULTRAGUI_VIDEO_DEMO_DIR; here both
//   are found from this package's directory.
// * UIContext::LoadVideo is ultragui_video::video_ui::load_video (a VideoId;
//   `video_var(ui, id)` is the C++ VideoPlayer*, `video_stop`/`video_seek`
//   its Stop/Seek through UIContext's Rhi).
// * The cube scene's paint lambda captures `video` and `&ui`; here it
//   captures the video's texture handle (created once at load, so
//   `video->texture()` is the same every frame) and reads the time and root
//   from the PaintEnv.
// * The C++ UIContext has the Lua runtime linked; nothing here runs a
//   script, so the port uses NoScript. The loop's function-level statics
//   (key states) are locals of main.

module ultragui_video_demo;

import {eprintln, println} from akikit::logging;
import {arguments} from akikit::process::command_line;
import {Command} from akikit::process::child;
import {output} from akikit::process::capture;
import {get_environment_variable} from akikit::process::environment_variables;
import {path_exists} from akikit::filesystem::file_util;
import {String, from_str} from akikit::strings::string;
import {Color} from ultragui::core::color;
import {LayoutEngine, LayoutViewport} from ultragui::layout::layout;
import {compute_widget_layout} from ultragui::layout::layout_tree;
import {paint_widget_tree} from ultragui::render::paint;
import {texture_id_from_rhi_handle} from ultragui::render::texture_backend;
import {Vertex2D} from ultragui::render::vertex;
import {Rhi} from ultragui::rhi::rhi;
import {RhiTextureHandle, kInvalidTexture} from ultragui::rhi::rhi_types;
import {NoScript} from ultragui::scripting::script_runtime;
import {kInvalidFont} from ultragui::text::text_engine;
import {PaintEnv, UIConfig, UIContext} from ultragui::ui_context;
import {set_image_texture} from ultragui::widgets::image;
import {set_text} from ultragui::widgets::text;
import {GlfwPlatform} from ultragui_glfw::platform_glfw;
import {
  GlfwWindow, glfw_get_key, kGlfwKey1, kGlfwKeyL, kGlfwKeyLeft, kGlfwKeyR, kGlfwKeyRight, kGlfwKeySpace, kGlfwPress,
} from ultragui_glfw::sys::glfw;
import {VulkanRhi} from ultragui_vulkan::vulkan_rhi;
import {load_video, video_seek, video_stop, video_var} from ultragui_video::video_ui;

extern("sqrtf") fn c_sqrtf(x: f32): f32;
extern("fabsf") fn c_fabsf(x: f32): f32;

fn sqrtf(x: f32): f32 => unsafe c_sqrtf(x);
fn fabsf(x: f32): f32 => unsafe c_fabsf(x);

fn find_font(): String? {
  if (let env = get_environment_variable("ULTRAGUI_FONT")) {
    if (path_exists(env.as_str())) {
      return env;
    }
  }
  var cmd = Command("sh");
  cmd.arg("-c");
  cmd.arg("fc-match -f '%{file}' 'sans:style=Regular' 2>/dev/null");
  let out = output(cmd) else {
    return none;
  };
  var n: usize = 0;
  while (n < out.stdout.len() && n < 1023) {
    n += 1;
    if (out.stdout[n - 1] == 0x0A) {
      break;
    }
  }
  while (n > 0 && (out.stdout[n - 1] == 0x0A || out.stdout[n - 1] == 0x0D)) {
    n -= 1;
  }
  if (n == 0) {
    return none;
  }
  var path = String();
  if (!path.push_utf8(out.stdout.as_slice()[..n] as bytes)) {
    return none;
  }
  return path_exists(path.as_str()) ? path : none;
}

