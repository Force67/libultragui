// libvkd3d-utils
pub extern("vkd3d_signal_event") fn vkd3d_signal_event(event: Handle): Hresult;
extern("D3D12SerializeRootSignature") fn raw_serialize_root_signature(desc: *const RootSignatureDesc, version: u32,
  blob: *var *var ID3D10Blob, error_blob: *var *var ID3D10Blob): Hresult;
extern("ugui_d3d12_serialize_root_signature") fn shim_serialize_root_signature(desc: *const RootSignatureDesc, version: u32,
  blob: *var *var ID3D10Blob, error_blob: *var *var ID3D10Blob): Hresult;

pub unsafe fn d3d12_serialize_root_signature(desc: *const RootSignatureDesc, version: u32,
  blob: *var *var ID3D10Blob, error_blob: *var *var ID3D10Blob): Hresult {
  unsafe {
    if (comptime @target_os() == "linux") {
      return shim_serialize_root_signature(desc, version, blob, error_blob);
    }
    return raw_serialize_root_signature(desc, version, blob, error_blob);
  }
}

