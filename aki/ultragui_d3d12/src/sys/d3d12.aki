// No C++ counterpart: the D3D12 API (vkd3d's <vkd3d_d3d12.h>, the C-style COM
// interface d3d12_rhi.cc uses through CINTERFACE) and vkd3d's own entry points
// (<vkd3d.h>, <vkd3d_utils.h>), declared by hand for the calls the port makes.
//
// * Structs are C's layout (`extern struct`). Every field defaults to zero so
//   `ResourceDesc {}` is the C++ `D3D12_RESOURCE_DESC desc = {}`. Field names
//   are the C names in snake_case without Hungarian prefixes (`pResource` is
//   `resource`, `Type` of a heap is `heap_type`); tools/gen_d3d12.py checks
//   every size and offset and every constant against the header, and the
//   result is tests/layout_test.aki.
// * Enums and flag sets are plain `u32` with `k...` constants (C's enums are
//   ints and the C++ ORs them), `kDxgiFormatX`, `kD3d12XY`.
// * COM interfaces are `extern struct`s holding only the vtable pointer
//   (`ID3D12Device`), whose vtable (`ID3D12DeviceVtbl`) lists every slot in
//   order: the methods the port calls have their function type, the others
//   are `*const u8` placeholders that keep the offsets. Between the markers
//   below the file is GENERATED by tools/gen_d3d12.py from vkd3d's headers
//   (vtable layout, parameter types, the IID constants, and one wrapper per
//   called method named `<iface>_<method>`: `dev_create_fence`,
//   `cl_draw_instanced`). The wrappers are `unsafe fn`: they call through the
//   object's vtable.
// * On Linux those wrappers call csrc/d3d12_abi.c: vkd3d uses Microsoft's
//   calling convention on x86-64, while aki extern fn uses the platform C ABI.
//   Call COM methods through the wrappers, not directly through the vtable.
// * The C++ `ID3D12Resource_GetDesc(res)` style calls that return a struct
//   use vkd3d's hidden result pointer; the wrappers return the struct.
// * D3D12 on Linux is vkd3d over Vulkan, which has no DXGI: the C++ backend
//   presents through a Vulkan swapchain whose images it wraps as D3D12
//   resources (vkd3d_create_image_resource). The vkd3d calls below are what it
//   links against; on Windows there is no vkd3d (the C++ backend does not
//   build there either), the manifest only maps the link settings.

module ultragui_d3d12::sys::d3d12;

import {VkDevice, VkImage, VkInstance, VkPhysicalDevice, VkQueue} from ultragui_vulkan::sys::vulkan;

// --- Basic Windows types -----------------------------------------------------

pub type Hresult = i32;
pub type Handle = *var u8;

pub extern struct Guid : Copy {
  pub var data1: u32 = 0
  pub var data2: u16 = 0
  pub var data3: u16 = 0
  pub var data4: [u8; 8] = [0; 8]
}

pub extern struct Luid {
  pub var low_part: u32 = 0
  pub var high_part: i32 = 0
}

// RECT (D3D12_RECT is the same struct); named D3dRect and D3dBox where ultragui::core::rect::Rect and akikit's Box would clash.
pub extern struct D3dRect {
  pub var left: i32 = 0
  pub var top: i32 = 0
  pub var right: i32 = 0
  pub var bottom: i32 = 0
}

pub fn failed(hr: Hresult): bool => hr < 0;

