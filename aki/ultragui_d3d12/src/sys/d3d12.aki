// IUnknown::Release on any COM object (the C++ ID3D12*_Release macros); returns the new count.
extern("ugui_d3d12_release") fn shim_release(object: *var u8): u32;
pub unsafe fn com_release<T>(object: *var T): u32 {
  unsafe {
    if (comptime @target_os() == "linux") { return shim_release(object as *var u8); }
    return ((*(*(object as *var IUnknown)).vtbl).release)(object as *var IUnknown);
  }
}

