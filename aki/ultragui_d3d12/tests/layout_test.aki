static var failures: u32 = 0;

fn check(what: str, got: usize, want: usize) {
  if (got != want) {
    eprintln(f"FAIL {what}: got {got}, C has {want}");
    unsafe { failures += 1; }
  }
}

fn check_const(what: str, got: i64, want: i64) {
  if (got != want) {
    eprintln(f"FAIL {what}: got {got}, C has {want}");
    unsafe { failures += 1; }
  }
}

