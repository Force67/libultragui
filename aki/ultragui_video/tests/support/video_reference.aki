// Recorded from the C++ VideoPlayer decoding examples/demo.mpg through a
// recording RHI (tools/gen_reference.cc, aarch64 Linux). Regenerate with
// tools/gen_tables.py; do not edit by hand.

module support::video_reference;

// After each step of the scripted run: pl_mpeg's clock (position as f64
// bits), the player's flags, the RHI call counters, and FNV-1a of the three
// plane textures (all three together, then each).
pub struct StateRef : Copy {
  pub let scenario: str
  pub let step: i32
  pub let position_bits: u64
  pub let finished: bool
  pub let playing: bool
  pub let needs_convert: bool
  pub let updates: u32
  pub let creates: u32
  pub let converts: u32
  pub let frame_hash: u64
  pub let y_hash: u64
  pub let cb_hash: u64
  pub let cr_hash: u64
}

pub comptime let kWidth: u32 = 160;
pub comptime let kHeight: u32 = 120;
pub comptime let kDurationBits: u64 = 0x4034f77777777777;
pub comptime let kFrameRateBits: u64 = 0x403e000000000000;
// Handles the recording RHI hands out in order: render target 0, then Y, Cb, Cr.
pub comptime let kTextureHandle: u32 = 0;
pub comptime let kYHandle: u32 = 1;
pub comptime let kCbHandle: u32 = 2;
pub comptime let kCrHandle: u32 = 3;
pub comptime let kPlaneW: u32 = 160;
pub comptime let kPlaneH: u32 = 128;
pub comptime let kChromaW: u32 = 80;
pub comptime let kChromaH: u32 = 64;
// ConvertFrame before any Update: target, y, cb, cr.
pub static let kFirstConvert: [u32; 4] = [0, 1, 2, 3];
// set_volume(0.5); set_muted(true) then volume() bits, muted(): with and without an audio bridge.
pub comptime let kVolumeWithBridgeBits: u32 = 0x3f000000;
pub comptime let kMutedWithBridge: bool = true;
pub comptime let kVolumeWithoutBridgeBits: u32 = 0x3f800000;
pub comptime let kMutedWithoutBridge: bool = false;
// After unload: destroy_texture calls, render targets created and destroyed, converts, textures live.
pub comptime let kUnloadDestroys: u32 = 3;
pub comptime let kTargetCreates: u32 = 1;
pub comptime let kTargetDestroys: u32 = 1;
pub comptime let kTotalConverts: u32 = 156;
pub comptime let kLiveAfterUnload: usize = 0;

