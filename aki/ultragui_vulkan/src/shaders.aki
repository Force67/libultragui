// The SPIR-V loading both backends share: read_file() of vulkan_rhi.cc and
// ReadFile() of ugui_impl_vulkan.cc, and (no C++ counterpart) the SPIR-V of
// the bundled shaders embedded at build time for the `embed_shaders` feature
// (see shaders/README.md); the C++ always reads them from its shader_dir.

module ultragui_vulkan::shaders;

import {List} from akikit::containers::list;
import {read_bytes} from akikit::filesystem::file_util;

static let kQuadVert: bytes = @embed("../shaders/quad.vert.spv");
static let kQuadFrag: bytes = @embed("../shaders/quad.frag.spv");
static let kTextVert: bytes = @embed("../shaders/text.vert.spv");
static let kTextFrag: bytes = @embed("../shaders/text.frag.spv");
static let kVideoVert: bytes = @embed("../shaders/video.vert.spv");
static let kVideoFrag: bytes = @embed("../shaders/video.frag.spv");

// The embedded SPIR-V for a shader file name ("quad.vert.spv", ...); empty
// for a name that is not one of them.
pub fn embedded_shader(filename: str): bytes {
  if (filename == "quad.vert.spv") {
    return kQuadVert;
  }
  if (filename == "quad.frag.spv") {
    return kQuadFrag;
  }
  if (filename == "text.vert.spv") {
    return kTextVert;
  }
  if (filename == "text.frag.spv") {
    return kTextFrag;
  }
  if (filename == "video.vert.spv") {
    return kVideoVert;
  }
  if (filename == "video.frag.spv") {
    return kVideoFrag;
  }
  return [];
}

// read_file: the file's bytes, empty when it cannot be read.
fn read_file(path: str): List<byte> => read_bytes(path) ?? List();

// The SPIR-V of `filename`: from `dir` (empty when it cannot be read), or the
// embedded copy with the `embed_shaders` feature.
pub fn shader_code(dir: str, filename: str): List<byte> {
  if (comptime @feature("embed_shaders")) {
    var code: List<byte> = List();
    for (let b in embedded_shader(filename)) {
      code.push(b);
    }
    return code;
  }
  return read_file(f"{dir}/{filename}".as_str());
}
