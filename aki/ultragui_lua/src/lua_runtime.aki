  if (let n = r) {
    return n;
  } else (let e) {
    let (k, a, t, m) = raise_parts(e);
    return unsafe raise(l, k, a, t, m);
  }
}

extern(longjmp) fn c_ugui_tween(l: *var LuaState): i32 {
  let r = unsafe run_builtin(l, ugui_tween);
  if (let n = r) {
    return n;
  } else (let e) {
    let (k, a, t, m) = raise_parts(e);
    return unsafe raise(l, k, a, t, m);
  }
}

extern(longjmp) fn c_ugui_open_url(l: *var LuaState): i32 {
  let r = unsafe run_builtin(l, ugui_open_url);
  if (let n = r) {
    return n;
  } else (let e) {
    let (k, a, t, m) = raise_parts(e);
    return unsafe raise(l, k, a, t, m);
  }
}

// RegisterApi
unsafe fn register_api(l: *var LuaState) {
  unsafe {
    lua_newtable(l);

    lua_pushcfunction(l, @c_fn(c_ugui_find));
    lua_setfield(l, -2, c"find");

    lua_pushcfunction(l, @c_fn(c_ugui_get));
    lua_setfield(l, -2, c"get");

    lua_pushcfunction(l, @c_fn(c_ugui_set));
    lua_setfield(l, -2, c"set");

    lua_pushcfunction(l, @c_fn(c_ugui_log));
    lua_setfield(l, -2, c"log");

    lua_pushcfunction(l, @c_fn(c_ugui_after));
    lua_setfield(l, -2, c"after");

    lua_pushcfunction(l, @c_fn(c_ugui_tween));
    lua_setfield(l, -2, c"tween");

    lua_pushcfunction(l, @c_fn(c_ugui_open_url));
    lua_setfield(l, -2, c"open_url");

    lua_setglobal(l, c"ugui");
  }
}

fn impl_of(call&: LuaCall): *var LuaImpl => unsafe (call.runtime_ptr() as *var LuaImpl);

fn registered(call&: LuaCall, name: LuaText): WidgetId {
  let s = name.owned();
  return find_in_registry(unsafe *impl_of(call), s);
}

// LuaUguiAfter
fn ugui_after(var call&: LuaCall): i32 ! LuaRaise {
  let p = impl_of(call);
  let delay = try call.check_number(1);
  try call.check_type(2, kLuaTFunction);
  let l = call.state();
  unsafe {
    lua_pushvalue(l, 2);
    let r = luaL_ref(l, kLuaRegistryIndex);
    (*p).timers.push(TimerEntry { fire_time: (*p).current_time + delay, func_ref: r });
  }
  return 0;
}

// LuaUguiTween
fn ugui_tween(var call&: LuaCall): i32 ! LuaRaise {
  let p = impl_of(call);
  let name = try call.check_text(1);
  let prop = try call.check_text(2);

  var tw = TweenEntry {
    widget_name: name.owned(),
    property: prop.owned(),
    start_time: unsafe (*p).current_time,
    duration: 0.0,
    from_num: 0.0, to_num: 0.0,
    from_r: 0.0, from_g: 0.0, from_b: 0.0, from_a: 0.0,
    to_r: 0.0, to_g: 0.0, to_b: 0.0, to_a: 0.0,
    is_color: false,
    easing: 0,
  };

  if (call.type_of(3) == kLuaTString) {
    tw.is_color = true;
    if (let (r, g, b, a) = parse_hex_rgba(call.to_text(3))) {
      tw.from_r = r;
      tw.from_g = g;
      tw.from_b = b;
      tw.from_a = a;
    }
    let to = try call.check_text(4);
    if (let (r, g, b, a) = parse_hex_rgba(to)) {
      tw.to_r = r;
      tw.to_g = g;
      tw.to_b = b;
      tw.to_a = a;
    }
    tw.duration = try call.check_number(5);
    if (call.top() >= 6 && call.type_of(6) == kLuaTString) {
      tw.easing = parse_easing(call.to_text(6));
    }
  } else {
    tw.from_num = (try call.check_number(3)) as f32;
    tw.to_num = (try call.check_number(4)) as f32;
    tw.duration = try call.check_number(5);
    if (call.top() >= 6 && call.type_of(6) == kLuaTString) {
      tw.easing = parse_easing(call.to_text(6));
    }
  }

  // Cancel existing tween on same widget+property
  unsafe {
    var tweens& = (*p).tweens;
    var i: usize = 0;
    while (i < tweens.len()) {
      if (tweens[i].widget_name == tw.widget_name && tweens[i].property == tw.property) {
        let last = tweens.len() - 1;
        tweens.swap(i, last);
        tweens.pop();
      } else {
        i += 1;
      }
    }
    tweens.push(tw);
  }
  return 0;
}

// LuaUguiOpenUrl: Platform::OpenURL, the platform's (its open_url method)
// when the context has one, else the default.
fn ugui_open_url(var call&: LuaCall): i32 ! LuaRaise {
  let url = try call.check_string(1);
  if (var plat& = call.ctx.platform) {
    plat.open_url(url);
  } else {
    open_url(url);
  }
  return 0;
}

// LuaUguiFind
fn ugui_find(var call&: LuaCall): i32 ! LuaRaise {
  let name = try call.check_text(1);
  let w = registered(call, name);
  let l = call.state();
  let n& = (w.valid() ? call.world.get(kWidgetNode, w) : none) else {
    unsafe lua_pushnil(l);
    return 1;
  };
  unsafe {
    lua_newtable(l);
    push_c_text(l, n.name);
    lua_setfield(l, -2, c"name");
    lua_pushinteger(l, n.id as i64);
    lua_setfield(l, -2, c"id");
  }
  return 1;
}

// LuaUguiGetProp
fn ugui_get(var call&: LuaCall): i32 ! LuaRaise {
  let name = try call.check_text(1);
  let prop = try call.check_text(2);
  let w = registered(call, name);
  let l = call.state();
  let sc& = (w.valid() ? call.world.get(kStyleC, w) : none) else {
    unsafe lua_pushnil(l);
    return 1;
  };
  let s& = sc.style;
  unsafe {
    if (prop.eq_str("opacity")) {
      lua_pushnumber(l, s.opacity as f64);
    } else if (prop.eq_str("visible")) {
      lua_pushboolean(l, s.visibility == Visibility::Visible ? 1 : 0);
    } else if (prop.eq_str("font-size")) {
      lua_pushnumber(l, s.font_size as f64);
    } else if (prop.eq_str("corner-radius")) {
      lua_pushnumber(l, s.corner_radius as f64);
    } else {
      lua_pushnil(l);
    }
  }
  return 1;
}

// The "#rrggbb" / "#rrggbbaa" a property takes: Color::FromHex, alpha
// replaced with aa/255 when given. none when the text is neither.
fn parse_color_prop(val: LuaText): Color? {
  if (val.len == 0 || val.bytes()[0] != '#' as u8 || (val.len != 7 && val.len != 9)) {
    return none;
  }
  var hex: u32 = 0;
  from_chars_u32(val.ascii_run(1, 7), hex, 16);
  var c = Color::from_hex(hex);
  if (val.len == 9) {
    var alpha: u32 = 0;
    from_chars_u32(val.ascii_run(7, 9), alpha, 16);
    c = c.with_alpha(alpha as f32 / 255.0);
  }
  return c;
}

// width/height from a string: atof, a Percent when it ends in '%'.
fn parse_length_text(val: LuaText): Length {
  let v = unsafe atof(val.ptr) as f32;
  if (val.len > 1 && val.bytes()[val.len - 1] == '%' as u8) {
    return Length::percent(v);
  }
  return Length::px(v);
}

// LuaUguiSetProp
fn ugui_set(var call&: LuaCall): i32 ! LuaRaise {
  let name = try call.check_text(1);
  let prop = try call.check_text(2);

  let w = registered(call, name);
  let kind = if (let n& = (w.valid() ? call.world.get(kWidgetNode, w) : none)) { n.kind } else {
    report1("ugui/lua: ugui.set: widget '", name.ptr, "' not found");
    return 0;
  };

  var s: Style = call.world.get(kStyleC, w)!.style;

  if (prop.eq_str("opacity")) {
    s.opacity = (try call.check_number(3)) as f32;
  } else if (prop.eq_str("visible")) {
    s.visibility = call.to_boolean(3) ? Visibility::Visible : Visibility::Hidden;
    set_style(call.world, w, s);
    clear_animation_style(call.world, w);
    return 0;
  } else if (prop.eq_str("font-size")) {
    s.font_size = (try call.check_number(3)) as f32;
  } else if (prop.eq_str("corner-radius")) {
    let r = (try call.check_number(3)) as f32;
    s.corner_radius = r;
    s.corner_radius_tl = r;
    s.corner_radius_tr = r;
    s.corner_radius_br = r;
    s.corner_radius_bl = r;
  } else if (prop.eq_str("color")) {
    let val = try call.check_text(3);
    if (let c = parse_color_prop(val)) {
      s.text_color = c;
    }
  } else if (prop.eq_str("text-shadow-color")) {
    let val = try call.check_text(3);
    if (let c = parse_color_prop(val)) {
      s.text_shadow_color = c;
    }
  } else if (prop.eq_str("shadow-color")) {
    let val = try call.check_text(3);
    if (let c = parse_color_prop(val)) {
      s.shadow.color = c;
    }
  } else if (prop.eq_str("shadow-blur")) {
    s.shadow.blur = (try call.check_number(3)) as f32;
  } else if (prop.eq_str("cursor")) {
    let val = try call.check_text(3);
    if (val.eq_str("pointer")) {
      s.cursor = Cursor::Pointer;
    } else if (val.eq_str("text")) {
      s.cursor = Cursor::Text;
    } else if (val.eq_str("move")) {
      s.cursor = Cursor::Move;
    } else if (val.eq_str("not-allowed")) {
      s.cursor = Cursor::NotAllowed;
    } else {
      s.cursor = Cursor::Default;
    }
  } else if (prop.eq_str("background")) {
    let val = try call.check_text(3);
    if (val.eq_str("transparent")) {
      s.background = Color::transparent();
    } else if (let c = parse_color_prop(val)) {
      s.background = c;
    }
  } else if (prop.eq_str("width")) {
    if (call.type_of(3) == kLuaTString) {
      s.width = parse_length_text(call.to_text(3)!);
    } else {
      s.width = Length::px((try call.check_number(3)) as f32);
    }
  } else if (prop.eq_str("height")) {
    if (call.type_of(3) == kLuaTString) {
      s.height = parse_length_text(call.to_text(3)!);
    } else {
      s.height = Length::px((try call.check_number(3)) as f32);
    }
  } else if (prop.eq_str("selected")) {
    if (kind == WidgetKind::Dropdown) {
      set_dropdown_selected(call.world, w, (try call.check_integer(3)) as i32);
      return 0;
    }
  } else if (prop.eq_str("checked")) {
    if (kind == WidgetKind::Checkbox) {
      set_checked(call.world, call.ctx, w, call.to_boolean(3));
      return 0;
    }
  } else if (prop.eq_str("value")) {
    if (kind == WidgetKind::Slider) {
      set_slider_value(call.world, w, (try call.check_number(3)) as f32);
      return 0;
    }
  } else if (prop.eq_str("text")) {
    if (kind == WidgetKind::Text) {
      let t = try call.check_string(3);
      set_text(call.world, w, t);
      clear_animation_style(call.world, w);
      return 0;
    }
    if (kind == WidgetKind::Button) {
      let t = try call.check_string(3);
      set_button_label(call.world, w, t);
      clear_animation_style(call.world, w);
      return 0;
    }
  }

  set_style(call.world, w, s);
  // Cancel any active transition; otherwise animation_style_ overrides the
  // base style and the change waits for the transition to end.
  clear_animation_style(call.world, w);
  return 0;
}

// LuaUguiLog: printf("[ugui/lua] %s\n", msg).
fn ugui_log(var call&: LuaCall): i32 ! LuaRaise {
  let msg = try call.check_text(1);
  unsafe printf(c"[ugui/lua] %s\n", msg.ptr);
  return 0;
}
