module ultragui_lua::proto;

import {LuaState, luaL_newstate, lua_close, luaL_checklstring, lua_pushcclosure, lua_setglobal, luaL_loadbuffer, lua_pcall, lua_tostring, luaL_requiref, luaopen_base, lua_pop} from ultragui_lua::sys::lua;
import {World} from ultragui::widgets::widget_registry;
import {WidgetContext} from ultragui::widgets::widget_context;

extern fn printf(fmt: *const c_char, ...): i32;

pub struct Env<'w, 'a> {
  pub var world: &'w var World
  pub var ctx: &'w var WidgetContext<'a>
}

pub struct Holder {
  pub unowned var world: *var World = null
  pub unowned var ctx: *var u8 = null
}

static var gHolder: Holder = Holder {};

fn do_work(name: *const c_char) {
  unsafe {
    var w& = *gHolder.world;
    var c& = *(gHolder.ctx as *var WidgetContext<'static>);
    var env = Env { world: w, ctx: c };
    printf(c"work %s %d\n", name, env.ctx.ui_scale as f64);
  }
}

extern(longjmp) fn lua_hello(l: *var LuaState): i32 {
  unsafe {
    let s = luaL_checklstring(l, 1, null);
    do_work(s);
  }
  return 0;
}

pub fn run(var world&: World, var ctx&: WidgetContext) {
  unsafe {
    gHolder.world = &raw var world;
    var cv& = ctx;
    gHolder.ctx = &raw var cv as *var u8;
    let l = luaL_newstate();
    luaL_requiref(l, c"_G", @c_fn(luaopen_base), 1);
    lua_pop(l, 1);
    lua_pushcclosure(l, @c_fn(lua_hello), 0);
    lua_setglobal(l, c"hello");
    let src = "hello('x') hello(3) print(pcall(hello)) hello()";
    if (luaL_loadbuffer(l, @ptr(src) as *const c_char, #src, c"chunk") == 0) {
      if (lua_pcall(l, 0, 0, 0) != 0) {
        printf(c"err: %s\n", lua_tostring(l, -1));
      }
    }
    lua_close(l);
  }
}
