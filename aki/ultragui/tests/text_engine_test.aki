  GlyphRef { id: 43, f: [0x00000000, 0x00000000, 0x41408000, 0x3a000000, 0x3a000000, 0x3bb00000, 0x3bd00000, 0x41200000, 0x41400000, 0x3f800000, 0x41400000] },
