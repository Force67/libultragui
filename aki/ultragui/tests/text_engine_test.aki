  GlyphRef { id: 91, f: [0x00000000, 0x00000000, 0x40aa8000, 0x3db60000, 0x3a000000, 0x3dbc0000, 0x3b400000, 0x40c00000, 0x40a00000, 0x00000000, 0x40a00000] },
