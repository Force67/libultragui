// text/text_engine: shaping, the glyph atlas and line layout with DejaVu
// Sans, compared bit for bit with what the C++ engine computes for the same
// calls (tools/gen_reference.cc, the RUN/G/LAYOUT/LINE/ATLAS/OFFS lines), and
// the FreeType/HarfBuzz layouts ultragui::sys declares against offsetof.
// LP64 only: the offsets are those of Linux on x86-64 and aarch64.

module text_engine_test;

import {List} from akikit::containers::list;
import {read_bytes} from akikit::filesystem::file_util;
import {Vec2} from ultragui::core::math;
import {Color} from ultragui::core::color;
import {Rect} from ultragui::core::rect;
import {Vertex2D} from ultragui::render::vertex;
import {kNullTextureId} from ultragui::render::draw_data;
import {Rhi, RhiConfig} from ultragui::rhi::rhi;
import {RhiFilter, RhiFormat, RhiTextureHandle} from ultragui::rhi::rhi_types;
import {FontStyle, FontWeight} from ultragui::style::enums;
import {FtBitmap, FtFaceRec, FtGlyphSlotRec, FtOpenArgs, FtSizeMetrics, FtSizeRec} from ultragui::sys::freetype;
import {HbGlyphInfo, HbGlyphPosition} from ultragui::sys::harfbuzz;
import {Glyph, TextEngine, TextLayoutConfig, TextRun, kInvalidFont} from ultragui::text::text_engine;
import {Expect} from support::expect;

comptime let kFont: str = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";

struct RunRef {
  pub let text: str
  pub let size: f32
  pub let letter_spacing: f32
  pub let line_height_mult: f32
  pub let glyph_count: u32
  pub let metrics: [u32; 4]  // total_advance, ascent, descent, line_height
}

// glyph_id, then x_offset, y_offset, x_advance, u0, v0, u1, v1, bmp_w, bmp_h,
// bearing_x, bearing_y as f32 bits.
struct GlyphRef {
  pub let id: u32
  pub let f: [u32; 11]
}

static let kRuns: [RunRef; 3] = [
  RunRef { text: "Hello, World!", size: 16.0, letter_spacing: 0.0, line_height_mult: 1.0, glyph_count: 13, metrics: [0x42ce2000, 0x41700000, 0xc0800000, 0x41980000] },
  RunRef { text: "fi ffl AVATAR", size: 23.5, letter_spacing: 0.5, line_height_mult: 1.0, glyph_count: 10, metrics: [0x4314d000, 0x41b80000, 0xc0c00000, 0x41e00000] },
  RunRef { text: "x", size: 9.0, letter_spacing: 0.0, line_height_mult: 1.25, glyph_count: 1, metrics: [0x40aa8000, 0x41100000, 0xc0400000, 0x41480000] },
];

