{
  "version": 2,
  "width": 200, "height": 160,
  "duration": 2.5,
  "loop": true,
  "layers": [
    { "name": "bg", "shape": "rect", "x": 10, "y": 10, "w": 180, "h": 140,
      "corner-radius": 18, "fill": "#203040", "stroke": "#80c0ff", "stroke-width": 3 },
    { "name": "sq", "shape": "rect", "x": 20, "y": 20, "w": 40, "h": 30,
      "fill": "#ff8040c0", "stroke": "white", "stroke-width": 2,
      "keyframes": {
        "x": [ {"t": 0, "v": 20}, {"t": 0.5, "v": 140, "ease": "ease-in-out"}, {"t": 1, "v": 20, "ease": "ease-out"} ],
        "rotation": [ {"t": 0, "v": 0}, {"t": 1, "v": 360} ],
        "scale-x": [ {"t": 0, "v": 1}, {"t": 0.5, "v": 1.5, "ease": "ease-in"}, {"t": 1, "v": 1} ],
        "scale-y": [ {"t": 0, "v": 1}, {"t": 0.5, "v": 0.5}, {"t": 1, "v": 1} ],
        "corner-radius": [ {"t": 0, "v": 0}, {"t": 0.5, "v": 12}, {"t": 1, "v": 100} ],
        "fill": [ {"t": 0, "v": "#ff0000"}, {"t": 0.5, "v": "#00ff0080", "ease": "ease-in-out"}, {"t": 1, "v": "#0000ff"} ],
        "stroke": [ {"t": 0, "v": "black"}, {"t": 1, "v": "white"} ]
      } },
    { "name": "ball", "shape": "circle", "cx": 100, "cy": 80, "r": 14, "fill": "#ffee00",
      "keyframes": {
        "cy": [ {"t": 0, "v": 130}, {"t": 0.25, "v": 40, "ease": "ease-out"}, {"t": 0.5, "v": 130, "ease": "ease-in"}, {"t": 1, "v": 130} ],
        "r": [ {"t": 0, "v": 14}, {"t": 0.5, "v": 20}, {"t": 1, "v": 14} ],
        "opacity": [ {"t": 0, "v": 1}, {"t": 0.9, "v": 1}, {"t": 1, "v": 0} ]
      } },
    { "name": "oval", "shape": "ellipse", "cx": 50, "cy": 110, "rx": 30, "ry": 12,
      "fill": "none", "stroke": "#ff44aa", "stroke-width": 4, "opacity": 0.75,
      "keyframes": { "rx": [ {"t": 0, "v": 30}, {"t": 1, "v": 10} ], "rotation": [ {"t": 0, "v": 0}, {"t": 1, "v": 90} ] } },
    { "name": "squiggle", "shape": "path",
      "d": "M 120 100 C 130 80 150 120 160 100 S 180 80 190 110 L 190 130 Q 150 150 120 130 Z",
      "fill": "#44ddaa80", "stroke": "#116655", "stroke-width": 2,
      "keyframes": { "stroke-width": [ {"t": 0, "v": 1}, {"t": 0.5, "v": 6}, {"t": 1, "v": 1} ] } },
    { "name": "arc", "shape": "path", "d": "M 30 140 A 20 10 0 0 1 70 140 a 10 10 30 1 0 -20 -5",
      "fill": "none", "stroke": "#ffffff", "stroke-width": 1.5 },
    { "name": "grp", "shape": "group", "x": 100, "y": 20,
      "keyframes": { "rotation": [ {"t": 0, "v": 0}, {"t": 1, "v": 180} ], "scale-x": [ {"t": 0, "v": 1}, {"t": 1, "v": 0.6} ] },
      "children": [
        { "name": "g1", "shape": "circle", "cx": 0, "cy": 0, "r": 8, "fill": "#f00" },
        { "name": "g2", "shape": "rect", "x": 10, "y": -5, "w": 30, "h": 10, "fill": "#abcdef" },
        { "name": "inner", "shape": "group", "x": 5, "y": 5,
          "children": [ { "shape": "ellipse", "cx": 20, "cy": 20, "rx": 6, "ry": 3, "fill": "#33ff99" } ] }
      ] },
    { "name": "hidden", "shape": "circle", "cx": 10, "cy": 10, "r": 50, "fill": "#ffffff", "opacity": 0 },
    { "name": "masked", "shape": "rect", "x": 0, "y": 0, "w": 30, "h": 30, "mask": "bg", "fill": "$grad" },
    { "name": "weird", "shape": "blob", "width": 10, "height": 10, "fill": "#12345", "stroke": "red",
      "keyframes": { "bogus": [ {"t": 0, "v": 0.2}, {"t": 1, "v": 0.9} ], "w": [ {"t": 0, "v": 5}, {"t": 1, "v": 25} ] } }
  ]
}
