static let kTexCreated: Atomic<u32> = Atomic::<u32>(0);
static let kTexMismatches: Atomic<u32> = Atomic::<u32>(0);

struct RecordingBackend : TextureBackend {
  pub var next: u64 = 100

  pub fn create_texture(var self&, width: u32, height: u32, format: RhiFormat, pixels: bytes, filter: RhiFilter): TextureId {
    let i = kTexCreated.fetch_add(1) as usize;
    if (i >= #kTexHashes || fnv(pixels) != kTexHashes[i]) {
      let _ = kTexMismatches.fetch_add(1);
    }
    let id = self.next;
    self.next += 1;
    return id;
  }
  pub fn update_texture(var self&, id: TextureId, pixels: bytes) {}
  pub fn destroy_texture(var self&, id: TextureId) {}
}

fn style(var world&: World, e: WidgetId): &var Style => world.get_var(kStyleC, e)!.style;

fn color(r: f32, g: f32, b: f32, a: f32): Color => Color { r, g, b, a };

// The tree of tools/gen_paint_reference.cc, step for step.
fn build(var world&: World): [WidgetId; 9] {
  let root = create_panel(world, 1);
  {
    var s& = style(world, root);
    s.flex_direction = FlexDirection::Column;
    s.width = Length::px(400.0);
    s.height = Length::px(500.0);
    s.padding = EdgeInsets::new(10.0, 12.0, 14.0, 16.0);
    s.gap = 6.0;
    s.background = color(0.1, 0.1, 0.15, 1.0);
    s.corner_radius = 12.0;
    s.overflow = Overflow::Hidden;
  }
  let a = create_panel(world, 2);
  add_child(world, root, a);
  {
    var s& = style(world, a);
    s.height = Length::px(50.0);
    s.background = color(0.9, 0.2, 0.1, 1.0);
    s.background_end = color(0.1, 0.2, 0.9, 1.0);
    s.gradient_angle = 90.0;
    s.border_width = 2.0;
    s.border_color = color(1.0, 1.0, 1.0, 0.8);
    s.corner_radius = 7.0;
    s.shadow = BoxShadow { color: color(0.0, 0.0, 0.0, 0.5), blur: 8.0, spread: 2.0, offset: Vec2::new(2.0, 3.0), inset: false };
  }
  let b = create_panel(world, 3);
  add_child(world, root, b);
  {
    var s& = style(world, b);
    s.flex_direction = FlexDirection::Row;
    s.height = Length::px(60.0);
    s.margin = EdgeInsets::new(0.0, 20.0, 0.0, 20.0);
    s.rotation = 15.0;
    s.opacity = 0.5;
    s.gradient_stop_count = 3;
    s.gradient_stops[0] = GradientStop { position: 0.0, color: color(1.0, 0.0, 0.0, 1.0) };
    s.gradient_stops[1] = GradientStop { position: 0.5, color: color(0.0, 1.0, 0.0, 1.0) };
    s.gradient_stops[2] = GradientStop { position: 1.0, color: color(0.0, 0.0, 1.0, 1.0) };
    s.gradient_angle = 45.0;
    s.border_width = 3.0;
    s.border_color = color(0.2, 0.2, 0.2, 1.0);
    s.corner_radius = 10.0;
  }
  let b1 = create_panel(world, 4);
  add_child(world, b, b1);
  {
    var s& = style(world, b1);
    s.width = Length::percent(40.0);
    s.flex_grow = 0.0;
    s.background = color(1.0, 1.0, 0.0, 1.0);
  }
  let c = create_panel(world, 5);
  add_child(world, root, c);
  {
    var s& = style(world, c);
    s.height = Length::px(70.0);
    s.background = color(0.3, 0.6, 0.3, 1.0);
    s.background_end = color(0.0, 0.0, 0.0, 0.0);
    s.gradient_type = GradientType::Radial;
    s.background_end = color(0.0, 0.1, 0.0, 0.5);
    s.corner_radius_tl = 4.0;
    s.corner_radius_tr = 16.0;
    s.corner_radius_br = 2.0;
    s.corner_radius_bl = 9.0;
    s.shadow = BoxShadow { color: color(0.0, 0.0, 0.0, 0.6), blur: 5.0, spread: 1.0, offset: Vec2::new(1.0, 1.0), inset: true };
  }
  let d = create_panel(world, 6);
  add_child(world, root, d);
  {
    var s& = style(world, d);
    s.height = Length::px(40.0);
    s.backdrop_blur = 10.0;
    s.background = color(1.0, 1.0, 1.0, 0.2);
    s.border_width = 1.0;
    s.border_color = color(1.0, 1.0, 1.0, 0.05);
    s.corner_radius = 6.0;
  }
  world.get_var(kWidgetNode, d)!.tab_index = 0;
  let e = create_panel(world, 7);
  add_child(world, root, e);
  {
    var s& = style(world, e);
    s.height = Length::px(30.0);
    s.background = color(1.0, 0.0, 1.0, 1.0);
    s.visibility = Visibility::Hidden;
  }
  let f = create_panel(world, 8);
  add_child(world, root, f);
  {
    var s& = style(world, f);
    s.height = Length::px(30.0);
    s.background = color(0.0, 1.0, 1.0, 1.0);
    s.visibility = Visibility::Collapsed;
  }
  let g = create_panel(world, 9);
  add_child(world, root, g);
  {
    var s& = style(world, g);
    s.flex_grow = 1.0;
    s.gradient_stop_count = 2;
    s.gradient_stops[0] = GradientStop { position: 0.0, color: color(0.2, 0.2, 0.2, 1.0) };
    s.gradient_stops[1] = GradientStop { position: 1.0, color: color(0.8, 0.8, 0.8, 1.0) };
    s.gradient_type = GradientType::Radial;
    s.corner_radius = 20.0;
  }
  return [root, a, b, b1, c, d, e, f, g];
}

pub fn main(): i32 {
  var t = Expect();
  var world = World();
  let ws = build(world);
  var ctx = WidgetContext { ui_scale: 1.5 };
  set_context(world, ws[0], true);
  set_widget_state(world, ctx, ws[5], WidgetState::Focused);

  var engine = LayoutEngine();
  compute_widget_layout(world, ctx, ws[0], LayoutViewport { width: 800.0, height: 600.0, scale: 1.5 }, engine);
  for (let i in 0..9) {
    let tr = world.get(kTransform, ws[i])!;
    let want = kRects[i];
    t.eq_u32(world.get(kWidgetNode, ws[i])!.id, want[0], "rect row id");
    let got: [u32; 8] = [
      @bit_cast(u32, tr.rect.x), @bit_cast(u32, tr.rect.y), @bit_cast(u32, tr.rect.w), @bit_cast(u32, tr.rect.h),
      @bit_cast(u32, tr.content_rect.x), @bit_cast(u32, tr.content_rect.y), @bit_cast(u32, tr.content_rect.w),
      @bit_cast(u32, tr.content_rect.h),
    ];
    for (let k in 0..8) {
      t.that(got[k] == want[k + 1], f"widget {want[0]} rect field {k}: got 0x{got[k]:08x}, want 0x{want[k + 1]:08x}");
    }
  }

  var r = Renderer2D();
  let _ = r.init();
  r.set_display_size(Vec2::new(800.0, 600.0));
  r.set_texture_backend(TextureBackendBox::of(RecordingBackend {}));
  r.begin_frame();
  paint_widget_tree(world, ctx, ws[0], r);
  let dd = r.get_draw_data();
  check_draw_data(t, dd, DrawRef {
    counts: kCounts, quad_vertices: kQuadVertices[..], text_vertices: kTextVertices[..], quad_indices: kQuadIndices[..],
    text_indices: kTextIndices[..], commands: kCommands[..],
  });
  t.eq_u32(kTexCreated.load(), #kTexHashes as u32, "gradient textures created");
  t.eq_u32(kTexMismatches.load(), 0, "gradient texture pixels");
  // The paint walk restores the rects it shifted and records inherited opacity.
  t.that(world.get(kTransform, ws[3])!.inherited_opacity == 0.5, "inherited opacity");
  return t.finish();
}
