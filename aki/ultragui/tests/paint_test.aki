// layout_tree + render::paint + widgets::widget's paint_widget against the
// C++: a panel tree at ui scale 1.5 (padding, gap, margins, percent width,
// overflow clip, a shadowed bordered linear gradient, a rotated
// half-transparent multi-stop gradient with a border and an inheriting
// child, an inset-shadowed radial gradient with per-corner radii, a
// backdrop-blurred focused widget with its focus ring, a hidden and a
// collapsed widget, a radial multi-stop gradient that grows). Layout rects
// and the painted DrawData are compared bit for bit with
// tools/gen_paint_reference.cc's output (aarch64 Linux).

module paint_test;

import {Atomic} from akikit::threading::atomic;
import {Color} from ultragui::core::color;
import {WidgetId} from ultragui::core::handle;
import {Vec2} from ultragui::core::math;
import {EdgeInsets} from ultragui::core::rect;
import {LayoutEngine, LayoutViewport} from ultragui::layout::layout;
import {compute_widget_layout} from ultragui::layout::layout_tree;
import {paint_widget_tree} from ultragui::render::paint;
import {TextureId} from ultragui::render::draw_data;
import {Renderer2D} from ultragui::render::renderer2d;
import {TextureBackend, TextureBackendBox} from ultragui::render::texture_backend;
import {RhiFilter, RhiFormat} from ultragui::rhi::rhi_types;
import {FlexDirection, GradientType, Overflow, Visibility, WidgetState} from ultragui::style::enums;
import {Length} from ultragui::style::property_types;
import {BoxShadow, GradientStop, Style} from ultragui::style::style;
import {create_panel} from ultragui::widgets::panel;
import {add_child, kStyleC, kTransform, kWidgetNode, set_context, set_widget_state} from ultragui::widgets::widget;
import {WidgetContext} from ultragui::widgets::widget_context;
import {World} from ultragui::widgets::widget_registry;
import {CmdRef, DrawRef, check_draw_data, fnv} from support::draw_check;
import {Expect} from ultragui_testing::expect;

