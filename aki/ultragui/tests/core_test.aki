// The core value code against the C++, bit for bit: from_chars (tricky
// floats, ranges, grammar), IntroSort's tie order, easing curves, Style::Lerp,
// keyframe animations and transitions, vertex packing. The tables are the
// output of tools/gen_reference.cc (FC/FU/SORT/EASE/SPRING40/LERP/KEYF/
// TRANS/PACK/RADII lines). Plus the hand-checked basics: color and rect math,
// hex colors, style overrides and the animator's bookkeeping.

module core_test;

import {List} from akikit::containers::list;
import {HashMap} from akikit::containers::hash_map;
import {Animator, KeyframeAnimation, Keyframe, ScrollAnimation, StyleTransition} from ultragui::animation::animator;
import {clamp_min_max, erase_if, index_of, intro_sort, max, min, sorted_entries} from ultragui::core::algorithm;
import {Color, lerp_color} from ultragui::core::color;
import {FromCharsError, from_chars_f32, from_chars_u32} from ultragui::core::from_chars;
import {Vec2, Vec4, clamp, lerp} from ultragui::core::math;
import {EdgeInsets, Rect} from ultragui::core::rect;
import {parse_hex_color} from ultragui::core::string_utils;
import {pack_color, pack_radii, pack_radii_uniform} from ultragui::render::vertex;
import {FlexDirection, WidgetState} from ultragui::style::enums;
import {Length} from ultragui::style::property_types;
import {GradientStop, Style, StyleMask, StyleOverride, resolve_style} from ultragui::style::style;
import {EasingType, Transition, eval_easing, eval_transition} from ultragui::style::transition;
import {Expect} from ultragui_testing::expect;

struct FcRef {
  pub let text: str
  pub let ptr: usize
  pub let ec: u8
  pub let bits: u32
}

struct FuRef {
  pub let text: str
  pub let ptr: usize
  pub let ec: u8
  pub let value: u32
}

// from_chars_f32 from a value of 1.0f (0x3f800000).
static let kFloats: [FcRef; 33] = [
