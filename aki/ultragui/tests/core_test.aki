static let kEaseT: [f32; 9] = [-0.5, 0.0, 0.1, 0.25, 0.5, 0.7, 0.9, 1.0, 1.5];
// EvalEasing(Transition{easing: type}, t) per EasingType, in enum order.
static let kEase: [[u32; 9]; 6] = [
  [0x00000000, 0x00000000, 0x3dcccccd, 0x3e800000, 0x3f000000, 0x3f333333, 0x3f666666, 0x3f800000, 0x3f800000],
  [0x00000000, 0x00000000, 0x3a83126f, 0x3c800000, 0x3e000000, 0x3eaf9db2, 0x3f3a9fbd, 0x3f800000, 0x3f800000],
  [0x00000000, 0x00000000, 0x3e8ac085, 0x3f140000, 0x3f600000, 0x3f791687, 0x3f7fbe77, 0x3f800000, 0x3f800000],
  [0x00000000, 0x00000000, 0x3b83126f, 0x3d800000, 0x3f000000, 0x3f645a1c, 0x3f7ef9db, 0x3f800000, 0x3f800000],
  [0x00000000, 0x00000000, 0x3dc223e2, 0x3ed1284c, 0x3f4d6a4f, 0x3f70d5f4, 0x3f7e8b87, 0x3f800000, 0x3f800000],
  [0x00000000, 0x00000000, 0x3f2f88fc, 0x3f8c8dc3, 0x3f7deb32, 0x3f80243c, 0x3f7ff719, 0x3f7ffde9, 0x3f7ffde9],
