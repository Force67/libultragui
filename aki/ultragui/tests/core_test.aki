  FcRef { text: "1.2345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678e2", ptr: 131, ec: 0, bits: 0x42f6e9e0 },
];

// from_chars_u32 in base 16 from a value of 7.
static let kInts: [FuRef; 7] = [
  FuRef { text: "0", ptr: 1, ec: 0, value: 0 },
  FuRef { text: "ff", ptr: 2, ec: 0, value: 255 },
  FuRef { text: "FFFFFFFF", ptr: 8, ec: 0, value: 4294967295 },
  FuRef { text: "100000000", ptr: 9, ec: 2, value: 7 },
  FuRef { text: "12345g", ptr: 5, ec: 0, value: 74565 },
  FuRef { text: "", ptr: 0, ec: 1, value: 7 },
  FuRef { text: "zz", ptr: 0, ec: 1, value: 7 },
];

