// The font engine (ultragui::font) against FreeType 2.14.3 and HarfBuzz
// 13.2.1, bit for bit.
//
// tools/ft_oracle.c opens a face with FreeType, and for each pixel size
// records face->size->metrics, then FT_Load_Glyph(FT_LOAD_DEFAULT) of every
// glyph (outline points, tags, contours, flags or bitmap; slot metrics,
// advance, linear advances), then hb_ft's unhinted answers for every glyph
// (h advance, extents, contour point 0) and FT_Get_Advance(NO_HINTING). This
// test replays the same calls in the same order on a font::face::Face (the
// order matters: FreeType keeps hinting state between glyphs and sizes) and
// compares every field.
//
// Default: DejaVuSans, DejaVuSans-Bold, LiberationSans-Regular and
// NotoSansMono-Regular (the corpus has no NotoSans-Regular), sizes 6..48, 64,
// 96, all glyphs. FONT_SWEEP=1 runs every TrueType font and collection
// (face 0) under /usr/share/fonts at 7 9 11 12 13 14 16 18 20 24 32 48 72;
// FONT_SWEEP_FROM=n skips the first n fonts. Arguments name fonts to run at
// the default sizes instead. FONT_SIZES="a b c" overrides the sizes.
//
// Faces FreeType would hint with its autohinter (no fpgm, prep of at most 7
// bytes) and CFF faces only compare face, size and unhinted records; their
// hinted glyphs are counted as skipped.

module font_tt_test;

import {List} from akikit::containers::list;
import {create_directories, is_directory, list_directory} from akikit::filesystem::directory;
import {delete_file, file_info, read_bytes, real_path} from akikit::filesystem::file_util;
import {eprintln, println} from akikit::logging;
import {Command, exit_code} from akikit::process::child;
import {arguments} from akikit::process::command_line;
import {get_environment_variable} from akikit::process::environment_variables;
import {String, from_str} from akikit::strings::string;
import {parse_u64} from akikit::strings::string_to_number;
import {Face, kFaceFlagsComputed} from ultragui::font::face;
import {GlyphFormat, LoadedGlyph} from ultragui::font::outline;
import {FontError} from ultragui::font::sfnt;
import {ft_advance, hb_contour_point, hb_extents, hb_h_advance} from ultragui::font::unhinted;

comptime let kMaxReported: u64 = 30;

static let kDefaultFonts: [str; 4] = [
  "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
  "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
  "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
  "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf",
];

// --- Reading the records ----------------------------------------------------------

struct Rd {
  pub var pos: usize = 0
  pub var end: usize = 0
}

fn rd_u8(d&: [u8], var r&: Rd): u8 {
  let v = d[r.pos];
  r.pos += 1;
  return v;
}

fn rd_u16(d&: [u8], var r&: Rd): u16 {
  let v = (d[r.pos] as u16) | ((d[r.pos + 1] as u16) << 8);
  r.pos += 2;
  return v;
}

fn rd_u32(d&: [u8], var r&: Rd): u32 {
  let p = r.pos;
  let v = (d[p] as u32) | ((d[p + 1] as u32) << 8) | ((d[p + 2] as u32) << 16) | ((d[p + 3] as u32) << 24);
  r.pos += 4;
  return v;
}

fn rd_i32(d&: [u8], var r&: Rd): i32 => rd_u32(d, r) as i32;

fn rd_i64(d&: [u8], var r&: Rd): i64 {
  let lo = rd_u32(d, r) as u64;
  let hi = rd_u32(d, r) as u64;
  return (lo | (hi << 32)) as i64;
}

struct Totals {
  pub var fonts: u64 = 0
  pub var faces_failed: u64 = 0
  pub var sizes: u64 = 0
  pub var glyphs: u64 = 0
  pub var bitmaps: u64 = 0
  pub var skipped_autohint: u64 = 0
  pub var skipped_cff: u64 = 0
  pub var unhinted: u64 = 0
  pub var mismatches: u64 = 0
  pub var mismatched_glyphs: u64 = 0
}

fn report(var t&: Totals, label: str, what: String) {
  t.mismatches += 1;
  if (t.mismatches <= kMaxReported) {
    eprintln(f"{label}: {what}");
  }
}

fn check_i64(var t&: Totals, label: str, field: str, want: i64, have: i64): bool {
  if (want != have) {
    report(t, label, f"{field}: freetype {want}, aki {have}");
    return false;
  }
  return true;
}

// Compares one 'G' record with the engine's load.
fn compare_glyph(d&: [u8], var r&: Rd, var face&: Face, var t&: Totals, label: str) {
  let gid = rd_u32(d, r);
  let err = rd_i32(d, r);
  t.glyphs += 1;
  let lbl = f"{label} gid {gid}";
  if (face.is_cff()) {
    t.skipped_cff += 1;
    r.pos = r.end;
    return;
  }
  // An autohinted face still loads a strike's bitmaps itself.
  if (face.uses_autohinter() && (err != 0 || d[r.pos] != 1)) {
    t.skipped_autohint += 1;
    r.pos = r.end;
    return;
  }
  let res = face.load_glyph(gid);
  if (err != 0) {
    if (let g = res) {
      report(t, lbl.as_str(), f"freetype fails (error {err}), aki loads");
      t.mismatched_glyphs += 1;
    }
    r.pos = r.end;
    return;
  }
  var loaded: LoadedGlyph? = none;
  if (let x = res) {
    loaded = x;
  } else (let e) {
    report(t, lbl.as_str(), f"freetype loads, aki fails ({error_name(e)})");
    t.mismatched_glyphs += 1;
    r.pos = r.end;
    return;
  }
  let g = loaded!;
  let before = t.mismatches;
  let format = rd_u8(d, r);
  let names = ["width", "height", "horiBearingX", "horiBearingY", "horiAdvance", "vertBearingX", "vertBearingY",
               "vertAdvance"];
  let have = [g.metrics.width, g.metrics.height, g.metrics.hori_bearing_x, g.metrics.hori_bearing_y,
              g.metrics.hori_advance, g.metrics.vert_bearing_x, g.metrics.vert_bearing_y, g.metrics.vert_advance];
  for (let k in 0usize..8) {
    let _ = check_i64(t, lbl.as_str(), names[k], rd_i64(d, r), have[k]);
  }
  let _ = check_i64(t, lbl.as_str(), "advance.x", rd_i64(d, r), g.advance_x);
  let _ = check_i64(t, lbl.as_str(), "linearHoriAdvance", rd_i64(d, r), g.linear_hori_advance);
  let _ = check_i64(t, lbl.as_str(), "linearVertAdvance", rd_i64(d, r), g.linear_vert_advance);
  if (format == 0) {
    if (!(g.format is GlyphFormat::Outline)) {
      report(t, lbl.as_str(), from_str("freetype gives an outline, aki a bitmap"));
    } else {
      let n_points = rd_u32(d, r) as usize;
      let n_contours = rd_u32(d, r) as usize;
      let flags = rd_u32(d, r);
      let o& = g.outline;
      if (n_points != o.points.len() || n_contours != o.contours.len()) {
        report(t, lbl.as_str(), f"freetype {n_points} points {n_contours} contours, aki {o.points.len()} points {o.contours.len()} contours");
      } else {
        let _ = check_i64(t, lbl.as_str(), "outline flags", flags as i64, o.flags as i64);
        var first_bad: i64 = -1;
        for (let i in 0..n_points) {
          let x = rd_i64(d, r);
          let y = rd_i64(d, r);
          if (first_bad < 0 && (x != o.points[i].x || y != o.points[i].y)) {
            first_bad = i as i64;
            report(t, lbl.as_str(), f"point {i}: freetype ({x}, {y}), aki ({o.points[i].x}, {o.points[i].y})");
          }
        }
        for (let i in 0..n_points) {
          let tg = rd_u8(d, r);
          if (tg != o.tags[i]) {
            report(t, lbl.as_str(), f"tag {i}: freetype 0x{tg:02x}, aki 0x{o.tags[i]:02x}");
            break;
          }
        }
        for (let i in 0..n_contours) {
          let c = rd_u16(d, r);
          if (c != o.contours[i]) {
            report(t, lbl.as_str(), f"contour {i}: freetype {c}, aki {o.contours[i]}");
            break;
          }
        }
      }
    }
  } else if (format == 1) {
    t.bitmaps += 1;
    if (!(g.format is GlyphFormat::Bitmap)) {
      report(t, lbl.as_str(), from_str("freetype gives a bitmap, aki an outline"));
    } else {
      let b& = g.bitmap;
      let width = rd_u32(d, r);
      let rows = rd_u32(d, r);
      let pitch = rd_i32(d, r);
      let mode = rd_u8(d, r);
      let left = rd_i32(d, r);
      let top = rd_i32(d, r);
      if (width != b.width || rows != b.rows || pitch != b.pitch || mode != b.pixel_mode || left != g.bitmap_left ||
          top != g.bitmap_top) {
        report(t, lbl.as_str(), f"bitmap freetype {width}x{rows} pitch {pitch} mode {mode} at ({left}, {top}), aki {b.width}x{b.rows} pitch {b.pitch} mode {b.pixel_mode} at ({g.bitmap_left}, {g.bitmap_top})");
      } else {
        let n = (pitch < 0 ? 0 - pitch : pitch) as usize * rows as usize;
        for (let i in 0..n) {
          if (d[r.pos + i] != b.buffer[i]) {
            report(t, lbl.as_str(), f"bitmap byte {i}: freetype {d[r.pos + i]}, aki {b.buffer[i]}");
            break;
          }
        }
      }
    }
  }
  if (t.mismatches != before) {
    t.mismatched_glyphs += 1;
  }
  r.pos = r.end;
}

// Compares one 'H' record (hb_ft's unhinted answers).
fn compare_unhinted(d&: [u8], var r&: Rd, var face&: Face, var t&: Totals, label: str) {
  let gid = rd_u32(d, r);
  let aerr = rd_i32(d, r);
  let adv = rd_i64(d, r);
  let hadv = rd_i32(d, r);
  let has_ext = rd_u8(d, r) != 0;
  let ex = [rd_i32(d, r), rd_i32(d, r), rd_i32(d, r), rd_i32(d, r)];
  let has_pt = rd_u8(d, r) != 0;
  let cx = rd_i32(d, r);
  let cy = rd_i32(d, r);
  r.pos = r.end;
  t.unhinted += 1;
  let lbl = f"{label} gid {gid} (unhinted)";
  if (face.is_cff()) {
    // FT_Get_Advance and the hb advance come from hmtx; the rest needs the
    // CFF loader.
    if (aerr == 0) {
      if (let a = ft_advance(face, gid)) {
        let _ = check_i64(t, lbl.as_str(), "FT_Get_Advance", adv, a);
      }
    }
    let _ = check_i64(t, lbl.as_str(), "hb h_advance", hadv as i64, hb_h_advance(face, gid) as i64);
    return;
  }
  if (aerr == 0) {
    if (let a = ft_advance(face, gid)) {
      let _ = check_i64(t, lbl.as_str(), "FT_Get_Advance", adv, a);
    } else (let e) {
      report(t, lbl.as_str(), from_str("FT_Get_Advance: aki fails"));
    }
  }
  let _ = check_i64(t, lbl.as_str(), "hb h_advance", hadv as i64, hb_h_advance(face, gid) as i64);
  let e = hb_extents(face, gid);
  if (let x = e) {
    if (!has_ext) {
      report(t, lbl.as_str(), from_str("extents: freetype none, aki some"));
    } else if (x.x_bearing != ex[0] || x.y_bearing != ex[1] || x.width != ex[2] || x.height != ex[3]) {
      report(t, lbl.as_str(), f"extents: hb ({ex[0]}, {ex[1]}, {ex[2]}, {ex[3]}), aki ({x.x_bearing}, {x.y_bearing}, {x.width}, {x.height})");
    }
  } else if (has_ext) {
    report(t, lbl.as_str(), from_str("extents: hb some, aki none"));
  }
  let p = hb_contour_point(face, gid, 0);
  if (let q = p) {
    if (!has_pt || q.0 != cx || q.1 != cy) {
      report(t, lbl.as_str(), f"contour point 0: hb {(has_pt ? 1i32 : 0i32)} ({cx}, {cy}), aki ({q.0}, {q.1})");
    }
  } else if (has_pt) {
    report(t, lbl.as_str(), f"contour point 0: hb ({cx}, {cy}), aki none");
  }
}

fn error_name(e: FontError): str => match (e) {
  FontError::UnknownFileFormat => "UnknownFileFormat",
  FontError::InvalidArgument => "InvalidArgument",
  FontError::InvalidTable => "InvalidTable",
  FontError::TableMissing => "TableMissing",
  FontError::InvalidOutline => "InvalidOutline",
  FontError::InvalidComposite => "InvalidComposite",
  FontError::TooManyHints => "TooManyHints",
  FontError::InvalidPixelSize => "InvalidPixelSize",
  FontError::InvalidSizeHandle => "InvalidSizeHandle",
  FontError::UnimplementedFeature => "UnimplementedFeature",
  FontError::CffNotLoaded => "CffNotLoaded",
  FontError::MissingBitmap => "MissingBitmap",
  _ => "other",
};

// Replays one oracle file on a face opened from `path`.
fn replay(d&: [u8], path: str, var t&: Totals): bool {
  var r = Rd {};
  var face: Face? = none;
  var label = from_str(path);
  t.fonts += 1;
  while (r.pos + 4 <= #d) {
    let n = rd_u32(d, r) as usize;
    r.end = r.pos + n;
    let kind = rd_u8(d, r);
    if (kind == 70) {
      // 'F'
      let err = rd_i32(d, r);
      let bytes = read_bytes(path) else {
        eprintln(f"cannot read {path}");
        return false;
      };
      var data: List<u8> = List();
      for (let b in bytes) {
        data.push(b as u8);
      }
      let opened = Face::open(data, 0);
      if (err != 0) {
        if (let f = opened) {
          report(t, path, f"freetype cannot open the face (error {err}), aki can");
        }
        t.faces_failed += 1;
        return true;
      }
      var opened_face: Face? = none;
      if (let x = opened) {
        opened_face = x;
      } else (let e) {
        report(t, path, f"freetype opens the face, aki fails ({error_name(e)})");
        t.faces_failed += 1;
        return true;
      }
      var f = opened_face!;
      let _ = check_i64(t, path, "num_glyphs", rd_u32(d, r) as i64, f.num_glyphs as i64);
      let flags = rd_u32(d, r);
      // GLYPH_NAMES of a CFF face depends on its top dict (font/cff).
      let mask = f.is_cff() ? kFaceFlagsComputed & ~0x200u32 : kFaceFlagsComputed;
      let _ = check_i64(t, path, "face_flags", (flags & mask) as i64, (f.face_flags & mask) as i64);
      let _ = check_i64(t, path, "units_per_EM", rd_u32(d, r) as i64, f.units_per_em as i64);
      let _ = check_i64(t, path, "ascender", rd_i32(d, r) as i64, f.ascender as i64);
      let _ = check_i64(t, path, "descender", rd_i32(d, r) as i64, f.descender as i64);
      let _ = check_i64(t, path, "height", rd_i32(d, r) as i64, f.height as i64);
      let _ = check_i64(t, path, "max_advance_width", rd_i32(d, r) as i64, f.max_advance_width as i64);
      let _ = check_i64(t, path, "max_advance_height", rd_i32(d, r) as i64, f.max_advance_height as i64);
      let _ = check_i64(t, path, "num_faces", rd_u32(d, r) as i64, f.num_faces() as i64);
      let _ = check_i64(t, path, "num_fixed_sizes", rd_u32(d, r) as i64, f.strikes.num_strikes() as i64);
      face = f;
    } else if (kind == 83) {
      // 'S'
      let px = rd_u32(d, r);
      let err = rd_i32(d, r);
      label = f"{path} px {px}";
      t.sizes += 1;
      if (var f& = face) {
        var aki_ok = false;
        if (let x = f.set_pixel_size(px)) {
          aki_ok = true;
        }
        if ((err == 0) != aki_ok) {
          report(t, label.as_str(), f"FT_Set_Pixel_Sizes error {err}, aki {(err == 0 ? 1i32 : 0i32)}");
        }
        let m = f.size_metrics();
        let names = ["x_ppem", "y_ppem", "x_scale", "y_scale", "ascender", "descender", "height", "max_advance"];
        let have = [m.x_ppem as i64, m.y_ppem as i64, m.x_scale, m.y_scale, m.ascender, m.descender, m.height,
                    m.max_advance];
        for (let k in 0usize..8) {
          let _ = check_i64(t, label.as_str(), names[k], rd_i64(d, r), have[k]);
        }
      }
    } else if (kind == 71) {
      // 'G'
      if (var f& = face) {
        compare_glyph(d, r, f, t, label.as_str());
      }
    } else if (kind == 72) {
      // 'H'
      if (var f& = face) {
        compare_unhinted(d, r, f, t, label.as_str());
      }
    } else {
      eprintln(f"{path}: unknown record {kind}");
      return false;
    }
    r.pos = r.end;
  }
  return true;
}

// --- The oracle --------------------------------------------------------------------

fn modified(path: str): i64 {
  if (let info = file_info(path)) {
    return info.modified_ns;
  }
  return -1;
}

fn run(var cmd&: Command, what: str): bool {
  if (let status = cmd.status()) {
    if (exit_code(status) == 0) {
      return true;
    }
    eprintln(f"{what} failed (exit {exit_code(status)})");
  } else (let e) {
    eprintln(f"cannot start {what}");
  }
  return false;
}

// The output of a command, split at spaces and newlines.
fn words_of(prog: str, args&: [str], out_file: str): List<String> {
  var words: List<String> = List();
  var cmd = Command(prog);
  for (let a in args) {
    cmd.arg(a);
  }
  cmd.stdout_to(out_file);
  if (!run(cmd, prog)) {
    return words;
  }
  let text = read_bytes(out_file) else {
    return words;
  };
  var cur = String();
  for (let b in text) {
    let c = b as u8;
    if (c == 32 || c == 10 || c == 9) {
      if (cur.len() > 0) {
        words.push(cur);
        cur = String();
      }
    } else {
      cur.push_c8(c as c8);
    }
  }
  if (cur.len() > 0) {
    words.push(cur);
  }
  return words;
}

// Builds build/ft_oracle/ft_oracle unless it is newer than its source.
fn build_oracle(pkg: str, out_dir: str): String? {
  let tool = f"{pkg}/tools/ft_oracle.c";
  let exe = f"{out_dir}/ft_oracle";
  if (modified(exe.as_str()) > modified(tool.as_str())) {
    return exe;
  }
  let cc = get_environment_variable("FT_ORACLE_CC") ?? from_str("clang");
  let flags = words_of("pkg-config", ["--cflags", "--libs", "freetype2", "harfbuzz"], f"{out_dir}/pkg-config.txt".as_str());
  if (flags.len() == 0) {
    eprintln("pkg-config freetype2 harfbuzz gave nothing (run in the dev shell)");
    return none;
  }
  var cmd = Command(cc.as_str());
  cmd.arg("-O2");
  cmd.arg(tool.as_str());
  for (let f in flags) {
    cmd.arg(f.as_str());
  }
  cmd.arg("-o");
  cmd.arg(exe.as_str());
  if (!run(cmd, "compiling the FreeType oracle")) {
    return none;
  }
  return exe;
}

fn ends_with(s: str, suffix: str): bool => #s >= #suffix && s[#s - #suffix..] == suffix;

// Every font file under dir, sorted.
fn collect_fonts(dir: str, var out&: List<String>) {
  let names = list_directory(dir) else {
    return;
  };
  var sorted: List<String> = List();
  for (let n in names) {
    sorted.push(n.clone());
  }
  var i: usize = 1;
  while (i < sorted.len()) {
    var j = i;
    while (j > 0 && sorted[j].as_str() < sorted[j - 1].as_str()) {
      sorted.swap(j - 1, j);
      j -= 1;
    }
    i += 1;
  }
  for (let n in sorted) {
    if (n == "." || n == "..") {
      continue;
    }
    let p = f"{dir}/{n}";
    if (is_directory(p.as_str())) {
      collect_fonts(p.as_str(), out);
    } else if (ends_with(n.as_str(), ".ttf") || ends_with(n.as_str(), ".ttc") || ends_with(n.as_str(), ".TTF") ||
               ends_with(n.as_str(), ".otf")) {
      out.push(p);
    }
  }
}

fn env_u64(name: str, fallback: u64): u64 {
  if (let v = get_environment_variable(name)) {
    return parse_u64(v.as_str()) ?? fallback;
  }
  return fallback;
}

pub fn main(): i32 {
  let pkg = real_path(@package_dir()) else {
    eprintln("cannot resolve the package dir");
    return 1;
  };
  let out_dir = f"{pkg}/build/ft_oracle";
  create_directories(out_dir.as_str());
  let exe = build_oracle(pkg.as_str(), out_dir.as_str()) else {
    return 1;
  };
  var sweep = false;
  if (let s = get_environment_variable("FONT_SWEEP")) {
    sweep = true;
  }
  var fonts: List<String> = List();
  var sizes: List<String> = List();
  let args = arguments();
  if (args.len() > 0) {
    for (let i in 0..args.len()) {
      fonts.push(from_str(args[i]));
    }
  } else if (sweep) {
    collect_fonts("/usr/share/fonts", fonts);
  } else {
    for (let f in kDefaultFonts) {
      fonts.push(from_str(f));
    }
  }
  if (let s = get_environment_variable("FONT_SIZES")) {
    var cur = String();
    for (let c in s.as_str()) {
      if (c == ' ') {
        if (cur.len() > 0) {
          sizes.push(cur);
          cur = String();
        }
      } else {
        cur.push_c8(c);
      }
    }
    if (cur.len() > 0) {
      sizes.push(cur);
    }
  } else if (sweep) {
    for (let s in [7u32, 9, 11, 12, 13, 14, 16, 18, 20, 24, 32, 48, 72]) {
      sizes.push(f"{s}");
    }
  } else {
    for (let s in 6..49) {
      sizes.push(f"{s}");
    }
    sizes.push(from_str("64"));
    sizes.push(from_str("96"));
  }
  let from = env_u64("FONT_SWEEP_FROM", 0);
  var totals = Totals {};
  var ok = true;
  for (let i in 0..fonts.len()) {
    if ((i as u64) < from) {
      continue;
    }
    let font& = fonts[i];
    let record = f"{out_dir}/records.bin";
    var cmd = Command(exe.as_str());
    cmd.arg(font.as_str());
    cmd.arg("0");
    cmd.arg(record.as_str());
    for (let s in sizes) {
      cmd.arg(s.as_str());
    }
    if (!run(cmd, "the FreeType oracle")) {
      ok = false;
      continue;
    }
    let bytes = read_bytes(record.as_str()) else {
      eprintln(f"cannot read {record}");
      return 1;
    };
    let before = totals.mismatches;
    let glyphs_before = totals.mismatched_glyphs;
    ok = replay(bytes.as_slice() as &[u8], font.as_str(), totals) && ok;
    if (sweep || totals.mismatches != before) {
      println(f"{font}: {totals.mismatches - before} mismatches in {totals.mismatched_glyphs - glyphs_before} glyphs");
    }
    if (let e = delete_file(record.as_str())) {
    } else (let err) {
    }
  }
  println(f"{totals.fonts} fonts ({totals.faces_failed} not opened), {totals.sizes} sizes, {totals.glyphs} hinted glyph loads ({totals.bitmaps} bitmaps; skipped: {totals.skipped_autohint} autohinter, {totals.skipped_cff} CFF), {totals.unhinted} unhinted queries; {totals.mismatches} mismatches in {totals.mismatched_glyphs} glyphs");
  return ok && totals.mismatches == 0 ? 0 : 1;
}
