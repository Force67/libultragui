static let kTexCreated: Atomic<u32> = Atomic::<u32>(0);
static let kTexMismatches: Atomic<u32> = Atomic::<u32>(0);

fn fnv(pixels: bytes): u64 {
  var h: u64 = 1469598103934665603;
  for (let p in pixels) {
    h ^= p as u64;
    h = h *% 1099511628211;
  }
  return h;
}

// Checks each texture against the C++ hashes and mints ids 100, 101, ...
// as the C++ recording backend does.
struct RecordingBackend : TextureBackend {
  pub var next: u64 = 100

  pub fn create_texture(var self&, width: u32, height: u32, format: RhiFormat, pixels: bytes, filter: RhiFilter): TextureId {
    let i = kTexCreated.fetch_add(1) as usize;
    if (i >= 3 || fnv(pixels) != kTexHashes[i] || width != 64 || height != 64 || format != RhiFormat::Rgba8Unorm) {
      let _ = kTexMismatches.fetch_add(1);
    }
    let id = self.next;
    self.next += 1;
    return id;
  }
  pub fn update_texture(var self&, id: TextureId, pixels: bytes) {}
  pub fn destroy_texture(var self&, id: TextureId) {}
}

struct Submitted : Copy {
  pub var scissor: Rect
  pub var first_index: u32
  pub var count: u32
  pub var vertex_count: u32
  pub var texture: RhiTextureHandle
  pub var is_text: bool
}

// An Rhi that records what it is asked: textures (handles 99, 100, ...: ids
// 100, 101, ... after the +1 bias) and draws.
struct RecordingRhi : Rhi {
  pub var next: RhiTextureHandle = 99
  pub var scissor: Rect = Rect {}
  pub var draws: List<Submitted> = List()
  pub var hashes: List<u64> = List()

  pub fn init(var self&, config&: RhiConfig): bool => true;
  pub fn shutdown(var self&) {}
  pub fn begin_frame(var self&, clear_color: Color): bool => true;
  pub fn end_frame(var self&) {}
  pub fn set_scissor(var self&, rect: Rect) {
    self.scissor = rect;
  }
  pub fn reset_scissor(var self&) {}
  pub fn draw_triangles(var self&, vertices&: [Vertex2D], indices&: [u32], texture: RhiTextureHandle) {
    self.draws.push(Submitted {
      scissor: self.scissor, first_index: #indices == 0 ? 0 : indices[0], count: #indices as u32, vertex_count: #vertices as u32,
      texture, is_text: false,
    });
  }
  pub fn draw_text_triangles(var self&, vertices&: [Vertex2D], indices&: [u32], atlas_texture: RhiTextureHandle) {
    self.draws.push(Submitted {
      scissor: self.scissor, first_index: #indices == 0 ? 0 : indices[0], count: #indices as u32, vertex_count: #vertices as u32,
      texture: atlas_texture, is_text: true,
    });
  }
  pub fn create_texture(var self&, width: u32, height: u32, format: RhiFormat, pixels: bytes, filter: RhiFilter): RhiTextureHandle {
    self.hashes.push(fnv(pixels));
    let h = self.next;
    self.next += 1;
    return h;
  }
  pub fn update_texture(var self&, handle: RhiTextureHandle, pixels: bytes) {}
  pub fn destroy_texture(var self&, handle: RhiTextureHandle) {}
  pub fn acquire_frame(var self&): bool => true;
  pub fn create_render_target(var self&, width: u32, height: u32): RhiTextureHandle => kInvalidTexture;
  pub fn destroy_render_target(var self&, handle: RhiTextureHandle) {}
  pub fn begin_offscreen(var self&, target: RhiTextureHandle, clear_color: Color): bool => false;
  pub fn end_offscreen(var self&, target: RhiTextureHandle) {}
  pub fn convert_video_frame(var self&, target: RhiTextureHandle, y: RhiTextureHandle, cb: RhiTextureHandle, cr: RhiTextureHandle) {}
  pub fn display_size(self&): Vec2 => Vec2 { x: 800.0, y: 600.0 };
  pub fn dpi_scale(self&): f32 => 1.0;
}

// The scene of tools/gen_renderer_reference.cc, step for step.
fn scene(var r&: Renderer2D, run&: TextRun, prun&: TextRun, lay&: TextLayout) {
  r.draw_rect(Rect::new(10.5, 20.25, 100.0, 50.0), Color { r: 0.2, g: 0.4, b: 0.6, a: 0.8 }, pack_radii_uniform(8.0));
  r.draw_rect_gradient(Rect::new(30.0, 40.0, 120.0, 60.0), Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 },
                       Color { r: 0.0, g: 0.0, b: 1.0, a: 0.5 }, pack_radii(4.0, 6.0, 8.0, 10.0), 135.0);
  r.draw_shadow(Rect::new(50.0, 60.0, 80.0, 40.0), Color { r: 0.0, g: 0.0, b: 0.0, a: 0.4 }, 6.0, 2.0, Vec2::new(3.0, 4.0),
                pack_radii_uniform(5.0));
  r.draw_text(Vec2::new(12.0, 100.0), run, Color { r: 1.0, g: 1.0, b: 0.9, a: 1.0 }, kFontTextureId);
  r.push_scissor(Rect::new(0.0, 0.0, 200.0, 150.0));
  r.draw_inset_shadow(Rect::new(20.0, 20.0, 100.0, 60.0), Color { r: 0.1, g: 0.0, b: 0.2, a: 0.7 }, 5.0, 3.0, Vec2::new(1.0, 2.0),
                      pack_radii(2.0, 9.0, 3.0, 12.0));
  r.draw_bordered_rect(Rect::new(150.0, 100.0, 90.0, 70.0), Color { r: 0.9, g: 0.9, b: 0.9, a: 1.0 },
                       Color { r: 0.3, g: 0.3, b: 0.3, a: 1.0 }, 2.5, pack_radii_uniform(6.0));
  r.push_scissor(Rect::new(100.0, 50.0, 300.0, 300.0));
  r.draw_rect(Rect::new(120.0, 60.0, 10.0, 10.0), Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 });
  r.pop_scissor();
  r.pop_scissor();
  r.push_transform(Vec2::new(200.0, 200.0), 30.0);
  r.draw_rect(Rect::new(180.0, 190.0, 40.0, 20.0), Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 }, pack_radii_uniform(3.0));
  r.push_transform(Vec2::new(210.0, 205.0), -12.5);
  r.draw_text(Vec2::new(190.0, 195.0), run, Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }, kFontTextureId);
  r.pop_transform();
  r.pop_transform();
  r.draw_radial_gradient(Rect::new(300.0, 300.0, 64.0, 64.0), Color { r: 1.0, g: 1.0, b: 0.0, a: 1.0 },
                         Color { r: 0.0, g: 0.5, b: 0.5, a: 0.0 }, pack_radii_uniform(32.0));
  let stops: [GradientStop; 3] = [
    GradientStop { position: 0.0, color: Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 } },
    GradientStop { position: 0.4, color: Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 } },
    GradientStop { position: 1.0, color: Color { r: 0.0, g: 0.0, b: 1.0, a: 0.5 } },
  ];
  r.draw_multi_stop_gradient(Rect::new(400.0, 300.0, 100.0, 40.0), stops[..], GradientType::Linear, 60.0, pack_radii_uniform(4.0));
  r.draw_multi_stop_gradient(Rect::new(400.0, 350.0, 50.0, 50.0), stops[..], GradientType::Radial, 0.0);
  // Cached: no new texture.
  r.draw_radial_gradient(Rect::new(370.0, 300.0, 20.0, 20.0), Color { r: 1.0, g: 1.0, b: 0.0, a: 1.0 },
                         Color { r: 0.0, g: 0.5, b: 0.5, a: 0.0 });
  r.set_next_blur(12.0);
  r.draw_rect(Rect::new(0.0, 400.0, 300.0, 100.0), Color { r: 1.0, g: 1.0, b: 1.0, a: 0.5 }, pack_radii_uniform(10.0));
  r.set_next_blur(0.0);
  r.draw_rect(Rect::new(10.0, 410.0, 30.0, 30.0), Color { r: 0.5, g: 0.5, b: 0.5, a: 1.0 });
  r.draw_text_layout(Vec2::new(500.0, 100.0), prun, lay, Color { r: 0.8, g: 0.8, b: 0.8, a: 1.0 }, kFontTextureId, 90.0);
  r.draw_textured_rect(Rect::new(600.0, 500.0, 32.0, 32.0), 7, Color { r: 1.0, g: 0.5, b: 1.0, a: 1.0 }, 0);
}

fn check_vertices(var t&: Expect, got: &[Vertex2D], want: &[[u32; 12]], what: str) {
  t.that(#got == #want, f"{what}: vertex count {#got}, want {#want}");
  var bad: u32 = 0;
  for (let i in 0..(#got < #want ? #got : #want)) {
    let v = got[i];
    let w = want[i];
    let row: [u32; 12] = [
      @bit_cast(u32, v.pos[0]), @bit_cast(u32, v.pos[1]), @bit_cast(u32, v.uv[0]), @bit_cast(u32, v.uv[1]), v.color, v.color2,
      v.corner_radii, @bit_cast(u32, v.softness), @bit_cast(u32, v.half_size[0]), @bit_cast(u32, v.half_size[1]),
      @bit_cast(u32, v.border_width), v.border_color,
    ];
    for (let k in 0..12) {
      if (row[k] != w[k]) {
        if (bad < 12) {
          t.that(false, f"{what} vertex {i} field {k}: got 0x{row[k]:08x}, want 0x{w[k]:08x}");
        }
        bad += 1;
      }
    }
  }
  t.that(bad == 0, f"{what}: {bad} differing fields");
}

fn check_indices(var t&: Expect, got: &[u32], want: &[u32], what: str) {
  var same = #got == #want;
  if (same) {
    for (let i in 0..#got) {
      if (got[i] != want[i]) {
        same = false;
      }
    }
  }
  t.that(same, f"{what} indices");
}

fn check_draw_data(var t&: Expect, dd&: DrawData) {
  t.that(dd.valid, "draw data valid");
  t.that(dd.quad_vertex_count() == kCounts[0] && dd.quad_index_count() == kCounts[1] && dd.text_vertex_count() == kCounts[2] &&
           dd.text_index_count() == kCounts[3] && dd.command_count() == kCounts[4], "counts");
  check_vertices(t, dd.quad_vertices, kQuadVertices[..], "quad");
  check_vertices(t, dd.text_vertices, kTextVertices[..], "text");
  check_indices(t, dd.quad_indices, kQuadIndices[..], "quad");
  check_indices(t, dd.text_indices, kTextIndices[..], "text");
  t.that(#dd.commands == #kCommands, "command count");
  for (let i in 0..(#dd.commands < #kCommands ? #dd.commands : #kCommands)) {
    let c = dd.commands[i];
    let w = kCommands[i];
    let ok = @bit_cast(u32, c.clip_rect.x) == w.clip[0] && @bit_cast(u32, c.clip_rect.y) == w.clip[1] &&
             @bit_cast(u32, c.clip_rect.w) == w.clip[2] && @bit_cast(u32, c.clip_rect.h) == w.clip[3] && c.texture_id == w.texture &&
             c.index_offset == w.offset && c.elem_count == w.count && c.is_text == w.is_text && @bit_cast(u32, c.blur) == w.blur;
    t.that(ok, f"command {i}");
  }
  t.that(dd.display_size.x == 800.0 && dd.display_size.y == 600.0, "display size");
}

pub fn main(): i32 {
  var t = Expect();
  var te = TextEngine();
  t.that(te.init(), "text engine");
  let f = te.load_font("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
  te.begin_frame();
  let run = te.shape(f, "Hi, Wy!", 16.0);
  let prun = te.shape(f, "The quick brown fox jumps", 14.0);
  let lay = te.layout(prun, TextLayoutConfig { max_width: 90.0 });

  // Draw-data mode with a host backend: the C++ setup.
  {
    var r = Renderer2D();
    t.that(r.init(), "init");
    r.set_display_size(Vec2::new(800.0, 600.0));
    r.set_texture_backend(TextureBackendBox::of(RecordingBackend {}));
    r.begin_frame();
    scene(r, run, prun, lay);
    let dd = r.get_draw_data();
    check_draw_data(t, dd);
    t.eq_u32(kTexCreated.load(), 3, "three gradient textures (one cache hit)");
    t.eq_u32(kTexMismatches.load(), 0, "gradient texture pixels");

    // A second frame: the cache serves every gradient, nothing is created.
    r.begin_frame();
    scene(r, run, prun, lay);
    let dd2 = r.get_draw_data();
    check_draw_data(t, dd2);
    t.eq_u32(kTexCreated.load(), 3, "second frame: all cached");
  }

  // No texture sink: gradients fall back to flat (texture 0), no texture.
  {
    var r = Renderer2D();
    let _ = r.init();
    r.begin_frame();
    r.draw_radial_gradient(Rect::new(0.0, 0.0, 10.0, 10.0), Color::white(), Color::black());
    let dd = r.get_draw_data();
    t.that(dd.command_count() == 1 && dd.commands[0].texture_id == 0, "no sink: flat");
    t.that(dd.commands[0].clip_rect.w == 0.0, "no Rhi, no display size: empty default scissor");
  }

  // Legacy mode: an attached Rhi, gradients through it, submitted by
  // end_frame in emission order.
  {
    var rhi = RecordingRhi {};
    var r = Renderer2D();
    t.that(r.init_rhi(rhi), "init_rhi");
    r.set_display_size(Vec2::new(800.0, 600.0));
    r.set_rhi_texture_backend();
    r.begin_frame_rhi(rhi);
    scene(r, run, prun, lay);
    r.end_frame(rhi);
    t.that(rhi.hashes.len() == 3, "Rhi mode: three textures");
    var hashes_ok = rhi.hashes.len() == 3;
    for (let i in 0..rhi.hashes.len()) {
      hashes_ok = hashes_ok && rhi.hashes[i] == kTexHashes[i];
    }
    t.that(hashes_ok, "Rhi mode: texture pixels");
    t.that(rhi.draws.len() == #kCommands, "Rhi mode: one draw per command");
    for (let i in 0..(rhi.draws.len() < #kCommands ? rhi.draws.len() : #kCommands)) {
      let d = rhi.draws[i];
      let w = kCommands[i];
      let want_tex = w.is_text ? kInvalidTexture : rhi_handle_from_texture_id(w.texture);
      let ok = @bit_cast(u32, d.scissor.x) == w.clip[0] && @bit_cast(u32, d.scissor.y) == w.clip[1] &&
               @bit_cast(u32, d.scissor.w) == w.clip[2] && @bit_cast(u32, d.scissor.h) == w.clip[3] && d.count == w.count &&
               d.is_text == w.is_text && d.texture == want_tex &&
               d.vertex_count == (w.is_text ? kCounts[2] : kCounts[0]) &&
               d.first_index == (w.is_text ? kTextIndices[w.offset as usize] : kQuadIndices[w.offset as usize]);
      t.that(ok, f"Rhi mode: draw {i}: tex {d.texture} want {want_tex}, count {d.count} first {d.first_index} verts {d.vertex_count}");
    }
    // The next frame finds the real ids in the cache.
    r.begin_frame_rhi(rhi);
    scene(r, run, prun, lay);
    let dd = r.get_draw_data();
    check_draw_data(t, dd);
    t.that(rhi.hashes.len() == 3, "Rhi mode: second frame all cached");
  }
  return t.finish();
}
