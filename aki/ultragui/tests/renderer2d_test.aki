// render::renderer2d against the C++: one scene (rounded rects, a linear
// gradient at 135deg, shadows, an inset shadow under nested scissors, a
// bordered rect, rotated quads and text, radial and multi-stop gradient
// textures with a cache hit, a blurred quad, a text layout, a textured rect)
// drawn into a DrawData, compared bit for bit with what the C++ Renderer2D
// built (tools/gen_renderer_reference.cc, recorded on aarch64 Linux). Then
// the same scene through end_frame on a recording Rhi in Rhi-texture mode:
// the provisional gradient ids resolve to the ids the C++ batches carry.

module renderer2d_test;

import {List} from akikit::containers::list;
import {Atomic} from akikit::threading::atomic;
import {Color} from ultragui::core::color;
import {Vec2} from ultragui::core::math;
import {Rect} from ultragui::core::rect;
import {DrawData, TextureId, kFontTextureId} from ultragui::render::draw_data;
import {Renderer2D} from ultragui::render::renderer2d;
import {TextureBackend, TextureBackendBox, rhi_handle_from_texture_id} from ultragui::render::texture_backend;
import {Vertex2D, pack_radii, pack_radii_uniform} from ultragui::render::vertex;
import {Rhi, RhiConfig} from ultragui::rhi::rhi;
import {RhiFilter, RhiFormat, RhiTextureHandle, kInvalidTexture} from ultragui::rhi::rhi_types;
import {GradientType} from ultragui::style::enums;
import {GradientStop} from ultragui::style::style;
import {TextEngine, TextLayout, TextLayoutConfig, TextRun} from ultragui::text::text_engine;
import {Expect} from support::expect;

struct CmdRef : Copy {
  pub let clip: [u32; 4]
  pub let texture: u64
  pub let offset: u32
  pub let count: u32
  pub let is_text: bool
  pub let blur: u32
}

