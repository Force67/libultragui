// No C++ counterpart: the yoga C API layout::layout uses, declared by hand
// (yoga/Yoga.h, YGEnums.h, YGNode.h, YGNodeStyle.h, YGNodeLayout.h,
// YGConfig.h). Yoga itself is compiled from third_party/yoga (aki.toml
// c_sources). C enums are `int`: the YG* constants below are their values in
// this yoga version.

module ultragui::sys::yoga;

pub extern type YgNode;
pub extern type YgConfig;

pub type YgNodeRef = *var YgNode;
pub type YgNodeConstRef = *const YgNode;
pub type YgConfigRef = *var YgConfig;

pub extern struct YgSize {
  pub var width: f32
  pub var height: f32
}

// YGMeasureFunc
pub type YgMeasureFunc = extern fn(YgNodeConstRef, f32, i32, f32, i32): YgSize;

// YGUndefined (a quiet NaN).
pub comptime let kYgUndefined: f32 = 0.0 / 0.0;

// YGAlign
pub comptime let kYgAlignAuto: i32 = 0;
pub comptime let kYgAlignFlexStart: i32 = 1;
pub comptime let kYgAlignCenter: i32 = 2;
pub comptime let kYgAlignFlexEnd: i32 = 3;
pub comptime let kYgAlignStretch: i32 = 4;
pub comptime let kYgAlignBaseline: i32 = 5;
pub comptime let kYgAlignSpaceBetween: i32 = 6;
pub comptime let kYgAlignSpaceAround: i32 = 7;
pub comptime let kYgAlignSpaceEvenly: i32 = 8;

// YGDirection
pub comptime let kYgDirectionLtr: i32 = 1;

// YGDisplay
pub comptime let kYgDisplayFlex: i32 = 0;
pub comptime let kYgDisplayNone: i32 = 1;

// YGEdge
pub comptime let kYgEdgeLeft: i32 = 0;
pub comptime let kYgEdgeTop: i32 = 1;
pub comptime let kYgEdgeRight: i32 = 2;
pub comptime let kYgEdgeBottom: i32 = 3;

// YGFlexDirection
pub comptime let kYgFlexDirectionColumn: i32 = 0;
pub comptime let kYgFlexDirectionColumnReverse: i32 = 1;
pub comptime let kYgFlexDirectionRow: i32 = 2;
pub comptime let kYgFlexDirectionRowReverse: i32 = 3;

// YGGutter
pub comptime let kYgGutterColumn: i32 = 0;
pub comptime let kYgGutterRow: i32 = 1;
pub comptime let kYgGutterAll: i32 = 2;

// YGJustify
pub comptime let kYgJustifyFlexStart: i32 = 1;
pub comptime let kYgJustifyCenter: i32 = 2;
pub comptime let kYgJustifyFlexEnd: i32 = 3;
pub comptime let kYgJustifySpaceBetween: i32 = 4;
pub comptime let kYgJustifySpaceAround: i32 = 5;
pub comptime let kYgJustifySpaceEvenly: i32 = 6;

// YGOverflow
pub comptime let kYgOverflowVisible: i32 = 0;
pub comptime let kYgOverflowHidden: i32 = 1;
pub comptime let kYgOverflowScroll: i32 = 2;

// YGPositionType
pub comptime let kYgPositionTypeRelative: i32 = 1;
pub comptime let kYgPositionTypeAbsolute: i32 = 2;

// YGWrap
pub comptime let kYgWrapNoWrap: i32 = 0;
pub comptime let kYgWrapWrap: i32 = 1;
pub comptime let kYgWrapWrapReverse: i32 = 2;

// Config
pub extern("YGConfigNew") fn yg_config_new(): YgConfigRef;
pub extern("YGConfigFree") fn yg_config_free(config: YgConfigRef);

// Nodes
pub extern("YGNodeNewWithConfig") fn yg_node_new_with_config(config: YgConfigRef): YgNodeRef;
pub extern("YGNodeFreeRecursive") fn yg_node_free_recursive(node: YgNodeRef);
pub extern("YGNodeInsertChild") fn yg_node_insert_child(node: YgNodeRef, child: YgNodeRef, index: usize);
pub extern("YGNodeGetChild") fn yg_node_get_child(node: YgNodeRef, index: usize): YgNodeRef;
pub extern("YGNodeSetContext") fn yg_node_set_context(node: YgNodeRef, context: *var u8);
pub extern("YGNodeGetContext") fn yg_node_get_context(node: YgNodeConstRef): *var u8;
pub extern("YGNodeSetMeasureFunc") fn yg_node_set_measure_func(node: YgNodeRef, measure: YgMeasureFunc);
pub extern("YGNodeMarkDirty") fn yg_node_mark_dirty(node: YgNodeRef);
pub extern("YGNodeCalculateLayout") fn yg_node_calculate_layout(node: YgNodeRef, available_width: f32, available_height: f32,
                                                               owner_direction: i32);

// Style
pub extern("YGNodeStyleSetFlexDirection") fn yg_node_style_set_flex_direction(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetJustifyContent") fn yg_node_style_set_justify_content(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetAlignItems") fn yg_node_style_set_align_items(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetAlignSelf") fn yg_node_style_set_align_self(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetAlignContent") fn yg_node_style_set_align_content(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetFlexWrap") fn yg_node_style_set_flex_wrap(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetOverflow") fn yg_node_style_set_overflow(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetPositionType") fn yg_node_style_set_position_type(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetDisplay") fn yg_node_style_set_display(node: YgNodeRef, v: i32);
pub extern("YGNodeStyleSetFlexGrow") fn yg_node_style_set_flex_grow(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetFlexShrink") fn yg_node_style_set_flex_shrink(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetFlexBasis") fn yg_node_style_set_flex_basis(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetFlexBasisPercent") fn yg_node_style_set_flex_basis_percent(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetFlexBasisAuto") fn yg_node_style_set_flex_basis_auto(node: YgNodeRef);
pub extern("YGNodeStyleSetWidth") fn yg_node_style_set_width(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetWidthPercent") fn yg_node_style_set_width_percent(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetWidthAuto") fn yg_node_style_set_width_auto(node: YgNodeRef);
pub extern("YGNodeStyleSetHeight") fn yg_node_style_set_height(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetHeightPercent") fn yg_node_style_set_height_percent(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetHeightAuto") fn yg_node_style_set_height_auto(node: YgNodeRef);
pub extern("YGNodeStyleSetMinWidth") fn yg_node_style_set_min_width(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMinWidthPercent") fn yg_node_style_set_min_width_percent(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMinHeight") fn yg_node_style_set_min_height(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMinHeightPercent") fn yg_node_style_set_min_height_percent(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMaxWidth") fn yg_node_style_set_max_width(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMaxWidthPercent") fn yg_node_style_set_max_width_percent(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMaxHeight") fn yg_node_style_set_max_height(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMaxHeightPercent") fn yg_node_style_set_max_height_percent(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetMargin") fn yg_node_style_set_margin(node: YgNodeRef, edge: i32, v: f32);
pub extern("YGNodeStyleSetPadding") fn yg_node_style_set_padding(node: YgNodeRef, edge: i32, v: f32);
pub extern("YGNodeStyleSetGap") fn yg_node_style_set_gap(node: YgNodeRef, gutter: i32, v: f32);
pub extern("YGNodeStyleSetAspectRatio") fn yg_node_style_set_aspect_ratio(node: YgNodeRef, v: f32);
pub extern("YGNodeStyleSetPosition") fn yg_node_style_set_position(node: YgNodeRef, edge: i32, v: f32);

// Layout results
pub extern("YGNodeLayoutGetLeft") fn yg_node_layout_get_left(node: YgNodeConstRef): f32;
pub extern("YGNodeLayoutGetTop") fn yg_node_layout_get_top(node: YgNodeConstRef): f32;
pub extern("YGNodeLayoutGetWidth") fn yg_node_layout_get_width(node: YgNodeConstRef): f32;
pub extern("YGNodeLayoutGetHeight") fn yg_node_layout_get_height(node: YgNodeConstRef): f32;
pub extern("YGNodeLayoutGetMargin") fn yg_node_layout_get_margin(node: YgNodeConstRef, edge: i32): f32;
pub extern("YGNodeLayoutGetPadding") fn yg_node_layout_get_padding(node: YgNodeConstRef, edge: i32): f32;
