// ugui/widgets/checkbox.{h,cc}: a checkbox (WidgetKind::Checkbox), a generic
// widget carrying a CheckboxContent (label, font, on_change); the checked
// flag is the widget's WidgetState::Checked bit. Behaviour: the Checkbox
// arms in widgets::widget_vtable (draw + measure + click).
//
// Shape differences: the World comes first; set_checked takes the context
// too, since a state change may start a state transition through the
// animator (SetWidgetState reached it through the widget's context pointer).

module ultragui::widgets::checkbox;

import {swap} from akikit::algorithm;
import {String, from_str} from akikit::strings::string;
import {max_f32, min_f32} from ultragui::core::algorithm;
import {Color} from ultragui::core::color;
import {ComponentKey} from ultragui::core::component_store;
import {WidgetId} from ultragui::core::handle;
import {Vec2} from ultragui::core::math;
import {Rect} from ultragui::core::rect;
import {Renderer2D} from ultragui::render::renderer2d;
import {pack_radii_uniform} from ultragui::render::vertex;
import {WidgetState, has_state} from ultragui::style::enums;
import {FontHandle, kInvalidFont} from ultragui::text::text_engine;
import {BoolHandler, CallbackEnv} from ultragui::widgets::callbacks;
import {
  WidgetKind, computed_style, kStyleC, kTransform, kWidgetNode, mark_dirty, set_widget_state, ui_scale, widget_context_of,
  widget_state_of,
} from ultragui::widgets::widget;
import {WidgetContext} from ultragui::widgets::widget_context;
import {World} from ultragui::widgets::widget_registry;

// Data for a checkbox widget. The checked flag lives in the state bit.
pub struct CheckboxContent {
  pub var label: String = String()
  pub var font: FontHandle = kInvalidFont  // override; kInvalidFont -> context default
  pub var on_change: BoolHandler? = none
}

pub static let kCheckboxContent: ComponentKey<CheckboxContent> = ComponentKey();

comptime let kGap: f32 = 8.0;

// CheckboxMeasure
pub fn checkbox_measure(var world&: World, var ctx&: WidgetContext, e: WidgetId): (f32, f32) {
  let st& = world.get(kStyleC, e)!.style;
  let sc = ui_scale(world, ctx, e);
  let box_size = st.font_size * 1.2;

  if (let c& = world.get(kCheckboxContent, e)) {
    if (let wc& = widget_context_of(world, ctx, e)) {
      let fh = c.font != kInvalidFont ? c.font : wc.default_font;
      if (var te& = wc.text_engine) {
        if (fh != kInvalidFont && !c.label.is_empty()) {
          let run = te.shape(fh, c.label.as_str(), st.font_size * sc, st.letter_spacing * sc, st.line_height_multiplier);
          return (box_size + kGap + run.total_advance, max_f32(box_size, run.line_height));
        }
      }
    }
  }
  return (box_size, box_size);
}

// CheckboxDraw. PaintWidget already drew background / shadow / border.
pub fn checkbox_draw(var world&: World, var ctx&: WidgetContext, e: WidgetId, var renderer&: Renderer2D) {
  var s = computed_style(world, e);
  s.scale(ui_scale(world, ctx, e));
  let alpha = s.opacity;
  let box_size = s.font_size * 1.0;
  let corner = min_f32(box_size * 0.2, 4.0);
  let radii = pack_radii_uniform(corner);

  let content = world.get(kTransform, e)!.content_rect;
  let box_x = content.x;
  let box_y = content.y + (content.h - box_size) * 0.5;

  if (is_checked(world, e)) {
    let accent = s.background.a > 0.0 ? s.background.with_alpha(s.background.a * alpha) : Color::from_hex(0x4a4aff, alpha);
    let border = s.border_color.a > 0.0 ? s.border_color.with_alpha(s.border_color.a * alpha) : accent;
    let bw = max_f32(s.border_width, 1.5);
    renderer.draw_bordered_rect(Rect { x: box_x, y: box_y, w: box_size, h: box_size }, accent, border, bw, radii);

    let inner_size = box_size * 0.45;
    let inner_x = box_x + (box_size - inner_size) * 0.5;
    let inner_y = box_y + (box_size - inner_size) * 0.5;
    let inner_corner = min_f32(inner_size * 0.2, 2.0);
    let inner_radii = pack_radii_uniform(inner_corner);
    renderer.draw_rect(Rect { x: inner_x, y: inner_y, w: inner_size, h: inner_size }, Color::rgba(1.0, 1.0, 1.0, alpha),
                       inner_radii);
  } else {
    let border = s.border_color.a > 0.0 ? s.border_color.with_alpha(s.border_color.a * alpha) : Color::rgba(0.6, 0.6, 0.6, alpha);
    let bw = max_f32(s.border_width, 1.5);
    renderer.draw_bordered_rect(Rect { x: box_x, y: box_y, w: box_size, h: box_size }, Color::transparent(), border, bw,
                                radii);
  }

  // Label to the right of the box.
  let c& = world.get(kCheckboxContent, e) else {
    return;
  };
  let wc& = widget_context_of(world, ctx, e) else {
    return;
  };
  let fh = c.font != kInvalidFont ? c.font : wc.default_font;
  var te& = wc.text_engine else {
    return;
  };
  if (fh == kInvalidFont || c.label.is_empty()) {
    return;
  }
  let run = te.shape(fh, c.label.as_str(), s.font_size, s.letter_spacing, s.line_height_multiplier);

  let text_x = box_x + box_size + kGap;
  let text_y = content.y + (content.h - run.line_height) * 0.5;

  let text_color = s.text_color.with_alpha(s.text_color.a * alpha);
  let atlas = te.atlas_texture();

  if (s.text_shadow_color.a > 0.0) {
    let shadow_pos = Vec2 { x: text_x + s.text_shadow_offset.x, y: text_y + s.text_shadow_offset.y };
    let shadow_color = s.text_shadow_color.with_alpha(s.text_shadow_color.a * alpha);
    renderer.draw_text(shadow_pos, run, shadow_color, atlas);
  }

  renderer.draw_text(Vec2 { x: text_x, y: text_y }, run, text_color, atlas);
}

// CheckboxClick: flip the checked bit, then on_change with the new value.
pub fn checkbox_click(var world&: World, var ctx&: WidgetContext, e: WidgetId): bool {
  let now = !is_checked(world, e);
  set_checked(world, ctx, e, now);
  var slot: BoolHandler? = none;
  if (var c& = world.get_var(kCheckboxContent, e)) {
    swap(c.on_change, slot);
  }
  if (let handler = slot) {
    {
      var env = CallbackEnv { world, ctx };
      handler(env, now);
    }
    if (var c& = world.get_var(kCheckboxContent, e)) {
      if (c.on_change == none) {
        c.on_change = handler;
      }
    }
  }
  return true;
}

// CreateCheckbox: a widget tagged Checkbox with a CheckboxContent.
pub fn create_checkbox(var world&: World, id: u32): WidgetId {
  let e = world.create(id);
  world.get_var(kWidgetNode, e)!.kind = WidgetKind::Checkbox;
  world.add(kCheckboxContent, e, CheckboxContent {});
  return e;
}

fn is_checkbox(world&: World, e: WidgetId): bool {
  if (let n& = world.get(kWidgetNode, e)) {
    return n.kind == WidgetKind::Checkbox;
  }
  return false;
}

// SetCheckboxLabel. No-op if `e` is not a checkbox.
pub fn set_checkbox_label(var world&: World, e: WidgetId, label: str) {
  if (!is_checkbox(world, e)) {
    return;
  }
  world.get_or_add(kCheckboxContent, e, CheckboxContent {}).label = from_str(label);
  mark_dirty(world, e);
}

// SetCheckboxChange: run with the new checked value when the user toggles
// it. No-op if `e` is not a checkbox.
pub fn set_checkbox_change(var world&: World, e: WidgetId, handler: BoolHandler) {
  if (!is_checkbox(world, e)) {
    return;
  }
  world.get_or_add(kCheckboxContent, e, CheckboxContent {}).on_change = handler;
}

// SetChecked: set or clear the Checked state bit. Does not fire on_change
// (that fires only on a user click). Works on any widget.
pub fn set_checked(var world&: World, var ctx&: WidgetContext, e: WidgetId, checked: bool) {
  var s = widget_state_of(world, e);
  if (checked) {
    s = s.with(WidgetState::Checked);
  } else {
    s = s.without(WidgetState::Checked);
  }
  set_widget_state(world, ctx, e, s);
}

// IsChecked: whether the widget's Checked state bit is set.
pub fn is_checked(world&: World, e: WidgetId): bool => has_state(widget_state_of(world, e), WidgetState::Checked);
