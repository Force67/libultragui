// ugui/widgets/text.{h,cc}: a text widget (WidgetKind::Text), a generic
// widget entity carrying a TextContent; its behaviour is the Text arms in
// widgets::widget_vtable (draw + measure).
//
// Shape differences: CreateText/SetText take the World first (no active
// registry); the measure and draw entries take the WidgetContext. The
// C++ apply_transform (copied into text.cc and button.cc) is one public
// function here, `apply_text_transform`, that button uses too.

module ultragui::widgets::text;

import {String, from_str} from akikit::strings::string;
import {to_lower_ascii, to_upper_ascii} from akikit::strings::string_util;
import {max_f32} from ultragui::core::algorithm;
import {ComponentKey} from ultragui::core::component_store;
import {WidgetId} from ultragui::core::handle;
import {Vec2} from ultragui::core::math;
import {Rect} from ultragui::core::rect;
import {Renderer2D} from ultragui::render::renderer2d;
import {FontStyle, FontWeight, TextAlign, TextDecoration, TextTransform, has_decoration} from ultragui::style::enums;
import {FontHandle, kInvalidFont} from ultragui::text::text_engine;
import {WidgetKind, computed_style, kStyleC, kTransform, kWidgetNode, mark_dirty, ui_scale, widget_context_of} from ultragui::widgets::widget;
import {WidgetContext} from ultragui::widgets::widget_context;
import {World} from ultragui::widgets::widget_registry;

// Text shown by a text widget.
pub struct TextContent : Clone {
  pub var text: String = String()
  pub var font: FontHandle = kInvalidFont  // override; kInvalidFont -> context default
}

pub static let kTextContent: ComponentKey<TextContent> = ComponentKey();

fn is_alpha(c: c8): bool => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');

// apply_transform: text-transform in the C locale (toupper/tolower/isalpha
// change ASCII letters only).
pub fn apply_text_transform(s: str, t: TextTransform): String {
  if (t == TextTransform::Uppercase) {
    return to_upper_ascii(s);
  }
  if (t == TextTransform::Lowercase) {
    return to_lower_ascii(s);
  }
  if (t == TextTransform::Capitalize) {
    var out = String();
    var next = true;
    for (let i in 0..#s) {
      var c = s[i];
      if (next && is_alpha(c)) {
        c = c >= 'a' && c <= 'z' ? ((c as u8) - 32) as c8 : c;
        next = false;
      }
      if (c == ' ') {
        next = true;
      }
      out.push_c8(c);
    }
    return out;
  }
  return from_str(s);
}

// TextMeasure
pub fn text_measure(var world&: World, var ctx&: WidgetContext, e: WidgetId): (f32, f32) {
  let c& = world.get(kTextContent, e) else {
    return (0.0, 0.0);
  };
  let wc& = widget_context_of(world, ctx, e) else {
    return (0.0, 0.0);
  };
  let fh = c.font != kInvalidFont ? c.font : wc.default_font;
  let sc = wc.ui_scale;
  var te& = wc.text_engine else {
    return (0.0, 0.0);
  };
  if (fh == kInvalidFont || c.text.is_empty()) {
    return (0.0, 0.0);
  }

  let st& = world.get(kStyleC, e)!.style;
  var resolved = fh;
  if (st.font_weight != FontWeight::Regular || st.font_style != FontStyle::Normal) {
    resolved = te.resolve_font(fh, st.font_weight, st.font_style);
  }

  let display_text = apply_text_transform(c.text.as_str(), st.text_transform);
  let run = te.shape(resolved, display_text.as_str(), st.font_size * sc, st.letter_spacing * sc, st.line_height_multiplier);
  return (run.total_advance, run.line_height);
}

// TextDraw. PaintWidget already drew background / shadow / border.
pub fn text_draw(var world&: World, var ctx&: WidgetContext, e: WidgetId, var renderer&: Renderer2D) {
  let c& = world.get(kTextContent, e) else {
    return;
  };
  var s = computed_style(world, e);
  s.scale(ui_scale(world, ctx, e));
  let wc& = widget_context_of(world, ctx, e) else {
    return;
  };
  let fh = c.font != kInvalidFont ? c.font : wc.default_font;
  var te& = wc.text_engine else {
    return;
  };
  if (fh == kInvalidFont || c.text.is_empty()) {
    return;
  }
  let alpha = s.opacity;

  var resolved = fh;
  if (s.font_weight != FontWeight::Regular || s.font_style != FontStyle::Normal) {
    resolved = te.resolve_font(fh, s.font_weight, s.font_style);
  }

  let display_text = apply_text_transform(c.text.as_str(), s.text_transform);

  // Always shape fresh: the scratch buffer pointer from measure may be stale.
  let run = te.shape(resolved, display_text.as_str(), s.font_size, s.letter_spacing, s.line_height_multiplier);

  let content = world.get(kTransform, e)!.content_rect;
  var x = content.x;
  var y = content.y;

  if (s.text_align == TextAlign::Center) {
    x += (content.w - run.total_advance) * 0.5;
  } else if (s.text_align == TextAlign::Right) {
    x += content.w - run.total_advance;
  }

  y += (content.h - run.line_height) * 0.5;

  let text_color = s.text_color.with_alpha(s.text_color.a * alpha);
  let atlas = te.atlas_texture();

  if (s.text_shadow_color.a > 0.0) {
    let shadow_pos = Vec2 { x: x + s.text_shadow_offset.x, y: y + s.text_shadow_offset.y };
    let shadow_color = s.text_shadow_color.with_alpha(s.text_shadow_color.a * alpha);
    renderer.draw_text(shadow_pos, run, shadow_color, atlas);
  }

  renderer.draw_text(Vec2 { x, y }, run, text_color, atlas);

  if (s.text_decoration != TextDecoration::None) {
    let dec_color = s.text_decoration_color.a > 0.0 ?
      s.text_decoration_color.with_alpha(s.text_decoration_color.a * alpha) : text_color;
    let thickness = max_f32(1.0, s.font_size / 14.0);
    let baseline = y + run.ascent;

    if (has_decoration(s.text_decoration, TextDecoration::Underline)) {
      let line_y = baseline + s.font_size * 0.15;
      renderer.draw_rect(Rect { x, y: line_y, w: run.total_advance, h: thickness }, dec_color);
    }
    if (has_decoration(s.text_decoration, TextDecoration::Strikethrough)) {
      let line_y = baseline - s.font_size * 0.3;
      renderer.draw_rect(Rect { x, y: line_y, w: run.total_advance, h: thickness }, dec_color);
    }
  }
}

// CreateText: a widget entity tagged Text with a TextContent.
pub fn create_text(var world&: World, id: u32): WidgetId {
  let e = world.create(id);
  world.get_var(kWidgetNode, e)!.kind = WidgetKind::Text;
  world.add(kTextContent, e, TextContent {});
  return e;
}

// SetText: the string a text widget displays. No-op if `e` is not a text
// widget.
pub fn set_text(var world&: World, e: WidgetId, text: str) {
  let n& = world.get(kWidgetNode, e) else {
    return;
  };
  if (n.kind != WidgetKind::Text) {
    return;
  }
  var content& = world.get_or_add(kTextContent, e, TextContent {});
  // Hosts drive their labels by writing every value every frame, so most
  // calls set the string that is already there. Comparing first skips both
  // the copy and mark_dirty, which walks the ancestor chain to the root.
  if (content.text == text) {
    return;
  }
  content.text = from_str(text);
  mark_dirty(world, e);
}
