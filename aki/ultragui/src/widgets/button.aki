// ugui/widgets/button.{h,cc}: a button (WidgetKind::Button), a generic
// widget entity carrying a ButtonContent (centered label, optional click
// handler); its behaviour is the Button arms in widgets::widget_vtable (draw
// + measure + click).
//
// Shape differences: the World comes first; the click handler is an
// widgets::callbacks::Action, which gets the World and context it runs with.

module ultragui::widgets::button;

import {swap} from akikit::algorithm;
import {String, from_str} from akikit::strings::string;
import {max_f32} from ultragui::core::algorithm;
import {ComponentKey} from ultragui::core::component_store;
import {WidgetId} from ultragui::core::handle;
import {Vec2} from ultragui::core::math;
import {Rect} from ultragui::core::rect;
import {Renderer2D} from ultragui::render::renderer2d;
import {FontStyle, FontWeight, TextDecoration, has_decoration} from ultragui::style::enums;
import {FontHandle, kInvalidFont} from ultragui::text::text_engine;
import {Action, CallbackEnv} from ultragui::widgets::callbacks;
import {apply_text_transform} from ultragui::widgets::text;
import {WidgetKind, computed_style, kStyleC, kTransform, kWidgetNode, mark_dirty, ui_scale, widget_context_of} from ultragui::widgets::widget;
import {WidgetContext} from ultragui::widgets::widget_context;
import {World} from ultragui::widgets::widget_registry;

// Data for a button widget: its centered label and an optional click handler.
pub struct ButtonContent {
  pub var label: String = String()
  pub var font: FontHandle = kInvalidFont  // override; kInvalidFont -> context default
  pub var on_click: Action? = none
}

pub static let kButtonContent: ComponentKey<ButtonContent> = ComponentKey();

// ButtonMeasure
pub fn button_measure(var world&: World, var ctx&: WidgetContext, e: WidgetId): (f32, f32) {
  let st& = world.get(kStyleC, e)!.style;
  let empty_size = (0.0f32, st.font_size + st.padding.vertical());
  let c& = world.get(kButtonContent, e) else {
    return empty_size;
  };
  let wc& = widget_context_of(world, ctx, e) else {
    return empty_size;
  };
  let fh = c.font != kInvalidFont ? c.font : wc.default_font;
  let sc = wc.ui_scale;
  var te& = wc.text_engine else {
    return empty_size;
  };
  if (fh == kInvalidFont || c.label.is_empty()) {
    return empty_size;
  }

  var resolved = fh;
  if (st.font_weight != FontWeight::Regular || st.font_style != FontStyle::Normal) {
    resolved = te.resolve_font(fh, st.font_weight, st.font_style);
  }

  let display_label = apply_text_transform(c.label.as_str(), st.text_transform);
  let run = te.shape(resolved, display_label.as_str(), st.font_size * sc, st.letter_spacing * sc, st.line_height_multiplier);
  return (run.total_advance + st.padding.horizontal(), run.line_height + st.padding.vertical());
}

// ButtonDraw. PaintWidget already drew background / shadow / border.
pub fn button_draw(var world&: World, var ctx&: WidgetContext, e: WidgetId, var renderer&: Renderer2D) {
  let c& = world.get(kButtonContent, e) else {
    return;
  };
  var s = computed_style(world, e);
  s.scale(ui_scale(world, ctx, e));
  let wc& = widget_context_of(world, ctx, e) else {
    return;
  };
  let fh = c.font != kInvalidFont ? c.font : wc.default_font;
  var te& = wc.text_engine else {
    return;
  };
  if (fh == kInvalidFont || c.label.is_empty()) {
    return;
  }
  let alpha = s.opacity;

  var resolved = fh;
  if (s.font_weight != FontWeight::Regular || s.font_style != FontStyle::Normal) {
    resolved = te.resolve_font(fh, s.font_weight, s.font_style);
  }

  let display_label = apply_text_transform(c.label.as_str(), s.text_transform);
  let run = te.shape(resolved, display_label.as_str(), s.font_size, s.letter_spacing, s.line_height_multiplier);

  let content = world.get(kTransform, e)!.content_rect;
  let x = content.x + (content.w - run.total_advance) * 0.5;
  let y = content.y + (content.h - run.line_height) * 0.5;

  let text_color = s.text_color.with_alpha(s.text_color.a * alpha);
  let atlas = te.atlas_texture();

  if (s.text_shadow_color.a > 0.0) {
    let shadow_pos = Vec2 { x: x + s.text_shadow_offset.x, y: y + s.text_shadow_offset.y };
    let shadow_color = s.text_shadow_color.with_alpha(s.text_shadow_color.a * alpha);
    renderer.draw_text(shadow_pos, run, shadow_color, atlas);
  }

  renderer.draw_text(Vec2 { x, y }, run, text_color, atlas);

  if (s.text_decoration != TextDecoration::None) {
    let dec_color = s.text_decoration_color.a > 0.0 ?
      s.text_decoration_color.with_alpha(s.text_decoration_color.a * alpha) : text_color;
    let thickness = max_f32(1.0, s.font_size / 14.0);
    let baseline = y + run.ascent;

    if (has_decoration(s.text_decoration, TextDecoration::Underline)) {
      let line_y = baseline + s.font_size * 0.15;
      renderer.draw_rect(Rect { x, y: line_y, w: run.total_advance, h: thickness }, dec_color);
    }
    if (has_decoration(s.text_decoration, TextDecoration::Strikethrough)) {
      let line_y = baseline - s.font_size * 0.3;
      renderer.draw_rect(Rect { x, y: line_y, w: run.total_advance, h: thickness }, dec_color);
    }
  }
}

// ButtonClick: run the click handler; false (not handled) without one.
pub fn button_click(var world&: World, var ctx&: WidgetContext, e: WidgetId): bool {
  var slot: Action? = none;
  if (var c& = world.get_var(kButtonContent, e)) {
    swap(c.on_click, slot);
  }
  let handler = slot else {
    return false;
  };
  {
    var env = CallbackEnv { world, ctx };
    handler(env);
  }
  if (var c& = world.get_var(kButtonContent, e)) {
    if (c.on_click == none) {
      c.on_click = handler;
    }
  }
  return true;
}

// CreateButton: a widget tagged Button with a ButtonContent.
pub fn create_button(var world&: World, id: u32): WidgetId {
  let e = world.create(id);
  world.get_var(kWidgetNode, e)!.kind = WidgetKind::Button;
  world.add(kButtonContent, e, ButtonContent {});
  return e;
}

fn is_button(world&: World, e: WidgetId): bool {
  if (let n& = world.get(kWidgetNode, e)) {
    return n.kind == WidgetKind::Button;
  }
  return false;
}

// SetButtonLabel. No-op if `e` is not a button.
pub fn set_button_label(var world&: World, e: WidgetId, label: str) {
  if (!is_button(world, e)) {
    return;
  }
  world.get_or_add(kButtonContent, e, ButtonContent {}).label = from_str(label);
  mark_dirty(world, e);
}

// SetButtonClick: the click handler. No-op if `e` is not a button.
pub fn set_button_click(var world&: World, e: WidgetId, handler: Action) {
  if (!is_button(world, e)) {
    return;
  }
  world.get_or_add(kButtonContent, e, ButtonContent {}).on_click = handler;
}
