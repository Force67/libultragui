// ugui/widgets/panel.{h,cc}: a plain container (WidgetKind::Panel): a
// generic widget entity that lays out its children by flex style and draws
// only the base box. It has no data component and no vtable entries; the
// base paint_widget handles everything.

module ultragui::widgets::panel;

import {WidgetId} from ultragui::core::handle;
import {WidgetKind, kWidgetNode} from ultragui::widgets::widget;
import {World} from ultragui::widgets::widget_registry;

// CreatePanel
pub fn create_panel(var world&: World, id: u32): WidgetId {
  let e = world.create(id);
  world.get_var(kWidgetNode, e)!.kind = WidgetKind::Panel;
  return e;
}
