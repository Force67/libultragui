// Bounds-checked CFF INDEX and DICT readers. Offsets remain in the owned
// table; no pointer views or native font libraries are used.
module ultragui::font::cff::data;

import {List} from akikit::containers::list;

// Numeric values agree with FreeType's public error codes where applicable.
pub enum CffError as i32 {
  InvalidFileFormat = 3, InvalidArgument = 6, InvalidGlyph = 16,
  InvalidTable = 142, StackOverflow = 130, StackUnderflow = 129,
  Unsupported = 7,
}

pub struct Span : Copy {
  pub var start: usize = 0
  pub var size: usize = 0
  pub fn limit(self&): usize => self.start + self.size;
}

pub struct Reader<'a> {
  pub let data: &'a [u8]
  pub var pos: usize = 0
  pub fn byte(var self&): u8 ! CffError {
    if (self.pos >= #self.data) { return fail CffError::InvalidTable; }
    let b = self.data[self.pos]; self.pos += 1; return b;
  }
  pub fn uint(var self&, n: usize): u32 ! CffError {
    var v = 0u32;
    for (let _ in 0..n) { v = (v << 8) | try self.byte() as u32; }
    return v;
  }
}

pub fn uint_at(data&: [u8], p: usize, n: usize): u32 ! CffError {
  var r = Reader { data, pos: p }; return try r.uint(n);
}

pub struct Index {
  pub var entries: List<Span> = List()
  pub var next: usize = 0
  pub fn parse(data&: [u8], p: usize, cff2: bool): Index ! CffError;
}

fn Index::parse(data&: [u8], p: usize, cff2: bool): Index ! CffError {
  var r = Reader { data, pos: p };
  let count = try r.uint(cff2 ? 4usize : 2usize) as usize;
  var out = Index {};
  if (count == 0) { out.next = r.pos; return out; }
  let n = try r.byte() as usize;
  if (n == 0 || n > 4 || count > #data || count + 1 > (#data - r.pos) / n) {
    return fail CffError::InvalidTable;
  }
  let base = r.pos + (count + 1) * n;
  var last = try r.uint(n) as usize;
  if (last != 1) { return fail CffError::InvalidTable; }
  out.entries.reserve(count);
  for (let _ in 0..count) {
    let next = try r.uint(n) as usize;
    if (next < last || next == 0 || next - 1 > #data - base) {
      return fail CffError::InvalidTable;
    }
    out.entries.push(Span { start: base + last - 1, size: next - last });
    last = next;
  }
  out.next = base + last - 1;
  return out;
}

pub struct DictEntry {
  pub var op: u16
  pub var args: List<i64> = List()
}

// Values are 16.16 in i64 so offsets and unsigned values retain their range.
// Decimal reals are converted as rational integers, without float fusion.
fn real(var r&: Reader): i64 ! CffError {
  var mantissa = 0i64; var fractional = 0i32; var exponent = 0i32;
  var negative = false; var dot = false; var exp = false; var exp_neg = false;
  var digits = 0u32;
  while (true) {
    let b = try r.byte();
    for (let shift in [4u8, 0u8]) {
      let c = (b >> shift) & 15;
      if (c == 15) {
        var power = (exp_neg ? -exponent : exponent) - fractional;
        var v = mantissa * 65536;
        if (power > 8) { return fail CffError::InvalidTable; }
        while (power > 0) { v *= 10; power -= 1; }
        if (power < -18) { return 0; }
        var den = 1i64;
        while (power < 0) { den *= 10; power += 1; }
        v = (v + den / 2) / den;
        return negative ? -v : v;
      }
      if (c < 10) {
        if (exp) { if (exponent < 1000) { exponent = exponent * 10 + c as i32; } }
        else {
          if (digits < 12) { mantissa = mantissa * 10 + c as i64; digits += 1; if (dot) { fractional += 1; } }
          else if (!dot) { fractional -= 1; }
        }
      } else if (c == 10) { dot = true; }
      else if (c == 11 || c == 12) { exp = true; exp_neg = c == 12; }
      else if (c == 14) { negative = true; }
      else { return fail CffError::InvalidTable; }
    }
  }
}

pub fn dict(data&: [u8], span: Span): List<DictEntry> ! CffError {
  if (span.start > #data || span.size > #data - span.start) { return fail CffError::InvalidTable; }
  var r = Reader { data: data[span.start..span.limit()] };
  var out = List::<DictEntry>(); var args = List::<i64>();
  while (r.pos < #r.data) {
    let b = try r.byte();
    if (b <= 21 && b != 28) {
      let op = b == 12 ? 0x100u16 + try r.byte() as u16 : b as u16;
      out.push(DictEntry { op, args }); args = List(); continue;
    }
    var v = 0i64;
    if (b == 28) { v = try r.uint(2) as i16 as i64 * 65536; }
    else if (b == 29) { v = try r.uint(4) as i32 as i64 * 65536; }
    else if (b == 30) { v = try real(r); }
    else if (b >= 32 && b <= 246) { v = (b as i64 - 139) * 65536; }
    else if (b >= 247 && b <= 250) { v = ((b as i64 - 247) * 256 + try r.byte() as i64 + 108) * 65536; }
    else if (b >= 251 && b <= 254) { v = (-(b as i64 - 251) * 256 - try r.byte() as i64 - 108) * 65536; }
    else { return fail CffError::InvalidTable; }
    if (args.len() >= 513) { return fail CffError::InvalidTable; }
    args.push(v);
  }
  return out;
}

pub struct PrivateDict {
  pub var default_width: i32 = 0
  pub var nominal_width: i32 = 0
  pub var local_subrs: Index = Index {}
  pub var blues: List<i32> = List()
  pub var other_blues: List<i32> = List()
  pub var family_blues: List<i32> = List()
  pub var family_other_blues: List<i32> = List()
  pub var blue_scale: i32 = 2596864  // .039625 * 1000 as 16.16
  pub var blue_shift: i32 = 7
  pub var blue_fuzz: i32 = 1
  pub var language_group: i32 = 0
  pub var vsindex: usize = 0
}

pub fn private_dict(data&: [u8], span: Span, cff2: bool): PrivateDict ! CffError {
  var out = PrivateDict {};
  let entries = try dict(data, span);
  for (let e in entries) {
    if (e.args.len() == 0) { continue; }
    let v = (e.args[0] >> 16) as i32;
    if (e.op == 19) {
      if (v < 0) { return fail CffError::InvalidTable; }
      out.local_subrs = try Index::parse(data, span.start + v as usize, cff2);
    } else if (e.op == 20) { out.default_width = v; }
    else if (e.op == 21) { out.nominal_width = v; }
    else if (e.op == 0x109) { out.blue_scale = (e.args[0] * 1000) as i32; }
    else if (e.op == 0x10a) { out.blue_shift = v; }
    else if (e.op == 0x10b) { out.blue_fuzz = v; }
    else if (e.op == 0x111) { out.language_group = v; }
    else if (e.op == 22) { out.vsindex = v < 0 ? 0usize : v as usize; }
    else if (e.op >= 6 && e.op <= 9) {
      var values = List::<i32>(); var sum = 0i32;
      for (let a in e.args) { sum = sum +% a as i32; values.push(sum); }
      if ((values.len() & 1) != 0) { values.truncate(values.len() - 1); }
      if (e.op == 6) { out.blues = values; }
      else if (e.op == 7) { out.other_blues = values; }
      else if (e.op == 8) { out.family_blues = values; }
      else { out.family_other_blues = values; }
    }
  }
  return out;
}

pub fn subr_bias(n: usize): i32 => n < 1240 ? 107 : (n < 33900 ? 1131 : 32768);
