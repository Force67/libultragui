  0, 0, 0, 0, 16, 16, 16, 16, 16, 0, 32, 32, 0, 0, 32, 32,
  0, 0, 32, 17, 32, 17, 17, 17, 32, 33, 33, 1, 1, 0, 0, 16,
  33, 33, 33, 33, 33, 33, 17, 17, 16, 0, 33, 33, 17, 16, 16, 16,
  33, 33, 33, 33, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17,
