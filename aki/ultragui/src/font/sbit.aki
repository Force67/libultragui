// Embedded bitmaps as FreeType 2.14.3 reads them: sfnt/ttsbit.c
// (tt_face_load_sbit, tt_face_load_strike_metrics, the EBLC/EBDT decoder)
// and the available_sizes setup of sfnt/sfobjs.c sfnt_load_face.
//
// Supported: EBLC/EBDT (and the identical CBLC/CBDT layout) index formats 1-5
// with image formats 1, 2, 5, 6, 7 (bit- and byte-aligned bitmaps with or
// without per-glyph metrics) and 8, 9 (compound glyphs). Not supported, so
// such glyphs fail to load where FreeType would give a bitmap: PNG images
// (CBDT formats 17-19; NotoColorEmoji's only strike is 109 ppem), sbix, and
// Apple 'bhed'-only bitmap fonts. The corpus has EBLC in arphic/uming.ttc
// (index 1/2, images 5/7) and kacst/mry_KacstQurn.ttf (index 1, image 2).

module ultragui::font::sbit;

import {List, filled} from akikit::containers::list;
import {div_fix, pix_round} from ultragui::font::fixed;
import {
  Directory, FontError, TableRecord, fits, i16_at, kTagBdat, kTagBloc, kTagCbdt, kTagCblc, kTagEbdt, kTagEblc, u16_at, u32_at,
} from ultragui::font::sfnt;
import {Bitmap, GlyphMetrics, kPixelModeBgra, kPixelModeGray, kPixelModeGray2, kPixelModeGray4, kPixelModeMono} from ultragui::font::outline;

// TT_SBit_MetricsRec.
pub struct SbitMetrics : Copy {
  pub var width: u8 = 0
  pub var height: u8 = 0
  pub var hori_bearing_x: i8 = 0
  pub var hori_bearing_y: i8 = 0
  pub var hori_advance: u8 = 0
  pub var vert_bearing_x: i8 = 0
  pub var vert_bearing_y: i8 = 0
  pub var vert_advance: u8 = 0
}

// One FT_Bitmap_Size and the EBLC strike it maps to.
pub struct StrikeSize : Copy {
  pub var strike: u32 = 0
  pub var height: i16 = 0
  pub var width: i16 = 0
  pub var x_ppem: i64 = 0
  pub var y_ppem: i64 = 0
}

pub struct StrikeTable {
  // EBLC (or CBLC) and EBDT (or CBDT) in the file.
  pub var eblc_offset: u32 = 0
  pub var eblc_size: u32 = 0
  pub var ebdt_offset: u32 = 0
  pub var ebdt_size: u32 = 0
  pub var num_raw_strikes: u32 = 0
  pub var units_per_em: u16 = 0
  // available_sizes (sbit_strike_map).
  pub var sizes: List<StrikeSize> = List()

  pub fn num_strikes(self&): u32 => self.sizes.len() as u32;
  // FT_Match_Size for a nominal request of w x h (26.6).
  pub fn match_size(self&, w: i64, h: i64): u32?;
  pub fn bsize_ppem(self&, strike: u32): (i64, i64) => (self.sizes[strike as usize].x_ppem, self.sizes[strike as usize].y_ppem);
  // tt_face_load_strike_metrics for an available size.
  pub fn strike_metrics(self&, d&: [u8], strike: u32): SizeMetricsRaw?;
}

// The FT_Size_Metrics a strike gives (font::face::SizeMetrics has the same
// fields; kept separate so this module does not import face).
pub struct SizeMetricsRaw : Copy {
  pub var x_ppem: u16 = 0
  pub var y_ppem: u16 = 0
  pub var x_scale: i64 = 0
  pub var y_scale: i64 = 0
  pub var ascender: i64 = 0
  pub var descender: i64 = 0
  pub var height: i64 = 0
  pub var max_advance: i64 = 0
}

fn first_table(dir&: Directory, a: u32, b: u32, c: u32): TableRecord? {
  if (let r = dir.find(a)) {
    return r;
  }
  if (let r = dir.find(b)) {
    return r;
  }
  return dir.find(c);
}

// tt_face_load_sbit + the available_sizes loop of sfnt_load_face.
// `avg_width` and `em_size` are OS/2's xAvgCharWidth and head's unitsPerEm
// (1 and 1 without OS/2), for FT_Bitmap_Size.width.
pub fn load_strikes(d&: [u8], dir&: Directory, units_per_em: u16, avg_width0: i16, has_os2: bool): StrikeTable {
  var t = StrikeTable {};
  t.units_per_em = units_per_em;
  let e = first_table(dir, kTagCblc, kTagEblc, kTagBloc) else {
    return t;
  };
  if (e.length < 8 || !fits(d, e.offset as u64, e.length as u64)) {
    return t;
  }
  let version = u32_at(d, e.offset as usize);
  let num_strikes = u32_at(d, (e.offset + 4) as usize);
  if ((version & 0xFFFF_0000) != 0x0002_0000 && (version & 0xFFFF) != 0x0200 && (version & 0xFFFF_0000) != 0x0003_0000 &&
      (version & 0xFFFF) != 0x0300) {
    return t;
  }
  if (num_strikes >= 0x10000) {
    return t;
  }
  var count = num_strikes;
  if (8 + 48 * count as u64 > e.length as u64) {
    count = (e.length - 8) / 48;
  }
  let b = first_table(dir, kTagCbdt, kTagEbdt, kTagBdat) else {
    return t;
  };
  if (b.length == 0) {
    return t;
  }
  t.eblc_offset = e.offset;
  t.eblc_size = e.length;
  t.ebdt_offset = b.offset;
  t.ebdt_size = b.length;
  t.num_raw_strikes = count;
  var avg_width = avg_width0 as i64;
  var em = units_per_em as i64;
  if (em == 0 || !has_os2) {
    avg_width = 1;
    em = 1;
  }
  for (let s in 0..count) {
    let m = t.raw_strike_metrics(d, s);
    let x_ppem = (m.x_ppem as i64) << 6;
    let y_ppem = (m.y_ppem as i64) << 6;
    if (x_ppem != 0 && y_ppem != 0) {
      t.sizes.push(StrikeSize {
        strike: s,
        height: (m.height >> 6) as i16,
        width: ((avg_width * m.x_ppem as i64 + em / 2) / em) as i16,
        x_ppem,
        y_ppem,
      });
    }
  }
  return t;
}

// tt_face_load_strike_metrics on the raw strike index (EBLC/CBLC only).
fn StrikeTable::raw_strike_metrics(self&, d&: [u8], s: u32): SizeMetricsRaw {
  let st = (self.eblc_offset + 8 + 48 * s) as usize;
  var m = SizeMetricsRaw {};
  m.x_ppem = d[st + 44] as u16;
  m.y_ppem = d[st + 45] as u16;
  m.ascender = (d[st + 16] as i8) as i64 * 64;
  m.descender = (d[st + 17] as i8) as i64 * 64;
  let max_before_bl = (d[st + 24] as i8) as i64;
  let min_after_bl = (d[st + 25] as i8) as i64;
  if (m.descender > 0) {
    if (min_after_bl < 0) {
      m.descender = 0 - m.descender;
    }
  } else if (m.descender == 0) {
    if (m.ascender == 0) {
      if (max_before_bl != 0 || min_after_bl != 0) {
        m.ascender = max_before_bl * 64;
        m.descender = min_after_bl * 64;
      } else {
        m.ascender = m.y_ppem as i64 * 64;
        m.descender = 0;
      }
    }
  }
  m.height = m.ascender - m.descender;
  if (m.height == 0) {
    m.height = m.y_ppem as i64 * 64;
    m.descender = m.ascender - m.height;
  }
  m.max_advance = ((d[st + 22] as i8) as i64 + d[st + 18] as i64 + (d[st + 23] as i8) as i64) * 64;
  m.x_scale = div_fix(m.x_ppem as i64 * 64, self.units_per_em as i64);
  m.y_scale = div_fix(m.y_ppem as i64 * 64, self.units_per_em as i64);
  return m;
}

fn StrikeTable::match_size(self&, w0: i64, h0: i64): u32? {
  let w = pix_round(w0);
  let h = pix_round(h0);
  if (w == 0 || h == 0) {
    return none;
  }
  for (let i in 0..self.sizes.len()) {
    let b = self.sizes[i];
    if (h != pix_round(b.y_ppem)) {
      continue;
    }
    if (w == pix_round(b.x_ppem)) {
      return i as u32;
    }
  }
  return none;
}

fn StrikeTable::strike_metrics(self&, d&: [u8], strike: u32): SizeMetricsRaw? {
  if (strike as usize >= self.sizes.len()) {
    return none;
  }
  return self.raw_strike_metrics(d, self.sizes[strike as usize].strike);
}
