// ugui/scripting/script_runtime.h and script_runtime_none.cc: the scripting
// runtime.
//
// The C++ ScriptRuntime is one concrete class whose implementation is
// swapped at link time (lua_runtime.cc, script_runtime_none.cc). Here it is
// the capability ScriptRuntime: UIContext is generic over it, NoScript (the
// script_runtime_none.cc stub) is the in-core implementation and the
// default, and the ultragui_lua package provides the Lua one.
//
// The C++ runtime reaches widgets through WidgetRegistry::Active(); here
// every method that can touch a widget, directly or from a script it runs,
// takes the World and the WidgetContext (widgets::widget_context). The
// Lua-only members stay out: ScheduleTimer (a Lua function reference),
// RegisterFunction and state() (lua_State) belong to ultragui_lua's type.
// Strings are `str`; Exec's default chunk name "chunk" is spelled out by
// callers (kDefaultChunkName).

module ultragui::scripting::script_runtime;

import {WidgetId, kNullWidget} from ultragui::core::handle;
import {WidgetContext} from ultragui::widgets::widget_context;
import {World} from ultragui::widgets::widget_registry;

// Exec's default `name`.
pub comptime let kDefaultChunkName: str = "chunk";

pub capability ScriptRuntime {
  fn init(var self&): bool;
  fn shutdown(var self&);

  // Execute a script from a string.
  fn exec(var self&, var world&: World, var ctx&: WidgetContext, script: str, name: str): bool;

  // Execute a script from a file path.
  fn exec_file(var self&, var world&: World, var ctx&: WidgetContext, path: str): bool;

  // Register a widget so the scripting layer can find it by name.
  fn register_widget(var self&, world&: World, widget: WidgetId);
  fn unregister_widget(var self&, world&: World, widget: WidgetId);
  fn clear_widget_registry(var self&);

  // Call a named handler function, passing the widget as context. True if
  // the handler existed and ran successfully.
  fn call_handler(var self&, var world&: World, var ctx&: WidgetContext, func_name: str, widget: WidgetId): bool;

  // Look up a registered widget by name; the null handle when there is none.
  fn find_registered_widget(self&, name: str): WidgetId;

  // Sync the timer clock without firing callbacks. Call before executing
  // scripts so timers use real time.
  fn sync_timer_clock(var self&, current_time: f64);

  // Cancel all pending timers and tweens (call when replacing the UI tree).
  fn clear_timers_and_tweens(var self&);

  // Process pending timers and tweens. Call each frame with the current time.
  fn update_timers(var self&, var world&: World, var ctx&: WidgetContext, current_time: f64);

  // Auto-wire on_change callbacks for Dropdown/Checkbox/Slider widgets in
  // the tree so they dispatch to on_<name>(w) handlers.
  fn wire_change_handlers(var self&, var world&: World, root: WidgetId);
}

// script_runtime_none.cc: scripting disabled. UIContext's default.
pub struct NoScript : ScriptRuntime, Copy {
  pub fn NoScript(): NoScript => NoScript {};

  pub fn init(var self&): bool => true;
  pub fn shutdown(var self&) {}
  pub fn exec(var self&, var world&: World, var ctx&: WidgetContext, script: str, name: str): bool => false;
  pub fn exec_file(var self&, var world&: World, var ctx&: WidgetContext, path: str): bool => false;
  pub fn register_widget(var self&, world&: World, widget: WidgetId) {}
  pub fn unregister_widget(var self&, world&: World, widget: WidgetId) {}
  pub fn clear_widget_registry(var self&) {}
  pub fn call_handler(var self&, var world&: World, var ctx&: WidgetContext, func_name: str, widget: WidgetId): bool => false;
  pub fn find_registered_widget(self&, name: str): WidgetId => kNullWidget;
  pub fn sync_timer_clock(var self&, current_time: f64) {}
  pub fn clear_timers_and_tweens(var self&) {}
  pub fn update_timers(var self&, var world&: World, var ctx&: WidgetContext, current_time: f64) {}
  pub fn wire_change_handlers(var self&, var world&: World, root: WidgetId) {}
}
