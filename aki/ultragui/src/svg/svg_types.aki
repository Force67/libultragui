// ugui/svg/svg_types.h: the SVG document model (transform, path, paint,
// shape, document) shared by the parser and the rasterizer.
//
// Differences in shape: `Transform::operator*` is `mul`; `Path::entries` is a
// `List<PathEntry>`; `Paint::Type` is the enum `PaintType`; `Vector<char>`
// byte buffers are `bytes`. The internal API of the header (ParseSvg,
// Rasterize, ParsePathData) lives in svg_parser and svg_rasterizer.

module ultragui::svg::svg_types;

import {List} from akikit::containers::list;
import {HashMap} from akikit::containers::hash_map;
import {String} from akikit::strings::string;
import {Color} from ultragui::core::color;
import {Vec2} from ultragui::core::math;

// --- 2D affine transform: [a c e; b d f; 0 0 1] ---

pub struct Transform : Copy {
  pub var a: f32 = 1.0
  pub var b: f32 = 0.0
  pub var c: f32 = 0.0
  pub var d: f32 = 1.0
  pub var e: f32 = 0.0
  pub var f: f32 = 0.0

  pub fn identity(): Transform => Transform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 };
  pub fn translate(tx: f32, ty: f32): Transform => Transform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: tx, f: ty };
  pub fn scale(sx: f32, sy: f32): Transform => Transform { a: sx, b: 0.0, c: 0.0, d: sy, e: 0.0, f: 0.0 };
  pub fn rotate(degrees: f32): Transform;
  // operator*: `self * r`.
  pub fn mul(self&, r&: Transform): Transform;
  pub fn apply(self&, p: Vec2): Vec2 => Vec2 { x: self.a * p.x + self.c * p.y + self.e, y: self.b * p.x + self.d * p.y + self.f };
}

fn Transform::rotate(degrees: f32): Transform {
  let rad = degrees * 3.14159265358979323846 / 180.0;
  let cs = @cos(rad);
  let sn = @sin(rad);
  return Transform { a: cs, b: sn, c: -sn, d: cs, e: 0.0, f: 0.0 };
}

fn Transform::mul(self&, r&: Transform): Transform => Transform {
  a: self.a * r.a + self.c * r.b,
  b: self.b * r.a + self.d * r.b,
  c: self.a * r.c + self.c * r.d,
  d: self.b * r.c + self.d * r.d,
  e: self.a * r.e + self.c * r.f + self.e,
  f: self.b * r.e + self.d * r.f + self.f,
};

// --- Path representation ---

pub enum PathCmd as u8 {
  MoveTo,   // 1 point
  LineTo,   // 1 point
  CubicTo,  // 3 points (c1, c2, end)
  Close,    // 0 points
}

pub struct PathEntry : Copy {
  pub var cmd: PathCmd
  pub var pts: [Vec2; 3]
}

pub struct Path {
  pub var entries: List<PathEntry>

  pub fn Path(): Path => Path { entries: List() };
  pub fn move_to(var self&, p: Vec2) {
    self.entries.push(PathEntry { cmd: PathCmd::MoveTo, pts: [p, Vec2 {}, Vec2 {}] });
  }
  pub fn line_to(var self&, p: Vec2) {
    self.entries.push(PathEntry { cmd: PathCmd::LineTo, pts: [p, Vec2 {}, Vec2 {}] });
  }
  pub fn cubic_to(var self&, c1: Vec2, c2: Vec2, end: Vec2) {
    self.entries.push(PathEntry { cmd: PathCmd::CubicTo, pts: [c1, c2, end] });
  }
  pub fn close(var self&) {
    self.entries.push(PathEntry { cmd: PathCmd::Close, pts: [Vec2 {}, Vec2 {}, Vec2 {}] });
  }
}

// --- Paint (fill/stroke) ---

pub enum FillRule as u8 { NonZero, EvenOdd }

pub struct GradientStop : Copy {
  pub var offset: f32 = 0.0
  pub var color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
}

pub enum GradientType as u8 { Linear, Radial }
pub enum SpreadMethod as u8 { Pad, Reflect, Repeat }

pub struct Gradient : Clone {
  pub var type_: GradientType = GradientType::Linear
  pub var x1: f32 = 0.0     // linear
  pub var y1: f32 = 0.0
  pub var x2: f32 = 1.0
  pub var y2: f32 = 0.0
  pub var cx: f32 = 0.5     // radial
  pub var cy: f32 = 0.5
  pub var r: f32 = 0.5
  pub var fx: f32 = -1.0    // radial focus (-1 = use center)
  pub var fy: f32 = -1.0
  pub var stops: List<GradientStop> = List()
  pub var transform: Transform = Transform::identity()
  pub var user_space: bool = false  // true = userSpaceOnUse
  pub var spread: SpreadMethod = SpreadMethod::Pad
}

pub enum PaintType as u8 { None, Solid, GradientRef }

pub struct Paint : Clone {
  pub var type_: PaintType = PaintType::None
  pub var color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  pub var gradient_id: String = String()
}

// --- Shape ---

pub struct Shape : Clone {
  pub var path: Path
  pub var fill: Paint = Paint {}
  pub var stroke: Paint = Paint {}
  pub var stroke_width: f32 = 1.0
  pub var opacity: f32 = 1.0
  pub var fill_opacity: f32 = 1.0
  pub var stroke_opacity: f32 = 1.0
  pub var fill_rule: FillRule = FillRule::NonZero
  pub var transform: Transform = Transform::identity()
}

// --- Document ---

pub struct Document {
  pub var width: f32 = 0.0
  pub var height: f32 = 0.0
  pub var view_x: f32 = 0.0
  pub var view_y: f32 = 0.0
  pub var view_w: f32 = 0.0
  pub var view_h: f32 = 0.0
  pub var shapes: List<Shape> = List()
  pub var gradients: HashMap<String, Gradient> = HashMap()

  pub fn Document(): Document => Document {};
}
