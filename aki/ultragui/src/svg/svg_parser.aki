// ugui/svg/svg_parser.cc: the minimal XML tokenizer, color/paint/transform/
// path-data/style parsing, basic shapes and gradients, and ParseSvg.
//
// Text the C++ reads as a NUL-terminated `const char*` is a `CText` (an
// attribute value, a style value) read by byte position; numbers come from
// libc's strtof/strtod through it (ultragui::sys::c_text), so they are the
// C++'s numbers. The XML itself is read from `bytes` with explicit bounds, as
// in the C++.
//
// Differences in shape: `ParseSvg(data, length, out)` is `parse_svg(data)`
// returning the document (none where the C++ returns false);
// `ParsePathData(d, path)` is `parse_path_data(d, path)`; the C++ attribute
// lookups returning `const char*` return `(&CText)?`.
//
// Three C++ loops never end on malformed input (text before the root, a
// stray close tag at top level, a path-data or polyline `points` value that
// stops being numbers). Each ends here at the first iteration that consumes
// no input; everything else about them is the C++.
//
// Known C++ quirks kept: a gradient stop without an `offset` has an
// uninitialized offset in the C++ (here 0); `style=` on a <stop> is parsed
// and ignored (the comment there says it wins; it does not).

module ultragui::svg::svg_parser;

import {List} from akikit::containers::list;
import {String, from_str} from akikit::strings::string;
import {intro_sort} from ultragui::core::algorithm;
import {Color} from ultragui::core::color;
import {Vec2, clamp} from ultragui::core::math;
import {CText} from ultragui::sys::c_text;
import {Document, FillRule, Gradient, GradientStop, GradientType, Paint, PaintType, Path, Shape, SpreadMethod, Transform} from ultragui::svg::svg_types;

// ============================================================================
// Character classes (the C locale's isspace/isalpha/isalnum/tolower)
// ============================================================================

fn is_space(c: u8): bool => c == 32 || (c >= 9 && c <= 13);
fn is_alpha(c: u8): bool => (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
fn is_alnum(c: u8): bool => is_alpha(c) || (c >= 48 && c <= 57);
fn to_lower(c: u8): u8 => (c >= 65 && c <= 90) ? c + 32 : c;

// `strncmp(t + p, lit, #lit) == 0`: lit has no NUL, so this is a prefix test.
fn starts_at(t&: CText, p: usize, lit: str): bool {
  for (let i in 0..#lit) {
    if (t.at(p + i) != lit[i] as u8) {
      return false;
    }
  }
  return true;
}

// `strchr(t, c) != nullptr`.
fn has_char(t&: CText, c: u8): bool {
  for (let i in 0..t.len()) {
    if (t.at(i) == c) {
      return true;
    }
  }
  return false;
}

// atof(t) as f32: strtod, then the conversion to float.
fn atof_f32(t&: CText): f32 => t.strtod_at(0).0 as f32;

// A String of `b`'s bytes as they are (the C++ String(first, last)).
fn string_of(b: bytes): String {
  var out = String();
  unsafe out.push_bytes(@ptr(b) as *const u8, #b);
  return out;
}

// ============================================================================
// Minimal XML tokenizer
// ============================================================================

struct XmlAttr {
  pub var name: String
  pub var value: CText
}

struct XmlNode {
  pub var tag: String
  pub var attrs: List<XmlAttr>
  pub var children: List<XmlNode>

  pub fn XmlNode(): XmlNode => XmlNode { tag: String(), attrs: List(), children: List() };

  pub fn attr(self&, name: str): (&CText)? {
    for (let a& in self.attrs) {
      if (a.name == name) {
        return a.value;
      }
    }
    return none;
  }

  pub fn attr_f(self&, name: str, def: f32 = 0.0): f32 {
    if (let v = self.attr(name)) {
      return atof_f32(v);
    }
    return def;
  }
}

struct XmlParser {
  pub let data: bytes
  pub var p: usize

  pub fn eof(self&): bool => self.p >= #self.data;
  pub fn peek(self&): u8 => self.eof() ? 0 : self.data[self.p] as u8;
  pub fn next(var self&): u8 {
    if (self.eof()) {
      return 0;
    }
    let c = self.data[self.p] as u8;
    self.p += 1;
    return c;
  }

  pub fn skip_ws(var self&) {
    while (!self.eof() && is_space(self.data[self.p] as u8)) {
      self.p += 1;
    }
  }

  pub fn skip_until(var self&, seq: str) {
    let len = #seq;
    while (!self.eof()) {
      if (#self.data - self.p >= len && self.matches(seq)) {
        self.p += len;
        return;
      }
      self.p += 1;
    }
  }

  // memcmp(p, seq, #seq) == 0, with the bounds checked by the caller.
  fn matches(self&, seq: str): bool {
    for (let i in 0..#seq) {
      if (self.data[self.p + i] as u8 != seq[i] as u8) {
        return false;
      }
    }
    return true;
  }

  pub fn read_name(var self&): String {
    let start = self.p;
    while (!self.eof()) {
      let c = self.data[self.p] as u8;
      if (!(is_alnum(c) || c == '-' as u8 || c == '_' as u8 || c == ':' as u8 || c == '.' as u8)) {
        break;
      }
      self.p += 1;
    }
    return string_of(self.data[start..self.p]);
  }

  pub fn read_quoted(var self&): String {
    let q = self.next();  // consume opening quote
    let start = self.p;
    while (!self.eof() && self.data[self.p] as u8 != q) {
      self.p += 1;
    }
    let result = string_of(self.data[start..self.p]);
    if (!self.eof()) {
      self.p += 1;  // consume closing quote
    }
    return result;
  }

  pub fn parse_node(var self&, var node&: XmlNode): bool;
}

fn XmlParser::parse_node(var self&, var node&: XmlNode): bool {
  self.skip_ws();
  if (self.eof() || self.peek() != '<' as u8) {
    return false;
  }
  self.p += 1;  // skip '<'

  // Skip comments, CDATA, processing instructions, DOCTYPE
  if (self.peek() == '!' as u8) {
    if (#self.data - self.p >= 2 && self.data[self.p] as u8 == '!' as u8 && self.data[self.p + 1] as u8 == '-' as u8) {
      self.skip_until("-->");
      return false;  // signal: skip, not a real node
    }
    // DOCTYPE or CDATA
    self.skip_until(">");
    return false;
  }
  if (self.peek() == '?' as u8) {
    self.skip_until("?>");
    return false;
  }
  if (self.peek() == '/' as u8) {
    // Close tag: caller handles this
    return false;
  }

  node.tag = self.read_name();
  if (node.tag.is_empty()) {
    return false;
  }

  // Parse attributes
  while (true) {
    self.skip_ws();
    if (self.eof()) {
      break;
    }
    if (self.peek() == '/' as u8 || self.peek() == '>' as u8) {
      break;
    }
    let name = self.read_name();
    if (name.is_empty()) {
      self.p += 1;
      continue;
    }
    var value = String();
    self.skip_ws();
    if (self.peek() == '=' as u8) {
      self.p += 1;
      self.skip_ws();
      if (self.peek() == '"' as u8 || self.peek() == '\'' as u8) {
        value = self.read_quoted();
      }
    }
    node.attrs.push(XmlAttr { name, value: CText(value.as_str()) });
  }

  var self_closing = false;
  if (self.peek() == '/' as u8) {
    self_closing = true;
    self.p += 1;
  }
  if (self.peek() == '>' as u8) {
    self.p += 1;
  }

  if (self_closing) {
    return true;
  }

  // Parse children
  while (true) {
    self.skip_ws();
    if (self.eof()) {
      break;
    }
    if (self.peek() == '<' as u8) {
      if (self.p + 1 < #self.data && self.data[self.p + 1] as u8 == '/' as u8) {
        // Close tag for current node
        self.p += 2;
        self.read_name();  // consume tag name
        self.skip_ws();
        if (self.peek() == '>' as u8) {
          self.p += 1;
        }
        break;
      }
      var child = XmlNode();
      if (self.parse_node(child) && !child.tag.is_empty()) {
        node.children.push(child);
      }
    } else {
      // Text content: skip for SVG
      while (!self.eof() && self.peek() != '<' as u8) {
        self.p += 1;
      }
    }
  }
  return true;
}

// ============================================================================
// Color parsing
// ============================================================================

// parse_hex_digit(c, out): the digit, none for a non-hex character (the
// caller's slot stays 0).
fn hex_digit(c: u8): u32? {
  if (c >= '0' as u8 && c <= '9' as u8) {
    return (c - '0' as u8) as u32;
  }
  if (c >= 'a' as u8 && c <= 'f' as u8) {
    return (c - 'a' as u8) as u32 + 10;
  }
  if (c >= 'A' as u8 && c <= 'F' as u8) {
    return (c - 'A' as u8) as u32 + 10;
  }
  return none;
}

