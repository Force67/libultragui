  let framebuffer_texture2d = resolve(loader, c"glFramebufferTexture2D", "glFramebufferTexture2D") else { return none; };
  let check_framebuffer_status = resolve(loader, c"glCheckFramebufferStatus", "glCheckFramebufferStatus") else { return none; };
