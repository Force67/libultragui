// Resolves one entry point. Prints the C++ loader's message when it is missing.
fn resolve(loader: GlLoader, name: *const c_char, text: str): (*var u8)? {
  let p = loader(name);
  if (p == null) {
    eprintln(f"ultragui: failed to load GL function '{text}'");
    return none;
  }
  return p;
}

fn GlApi::load(loader: GlLoader): GlApi? {
