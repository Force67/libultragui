// Hand-written for the golden comparison (see ../README.md, "Extra
// scenarios"): @media breakpoints, viewport scaling, tooltips, a few kinds.
panel root {
  width: 100%; height: 100%; padding: 24; gap: 12;
  background: #14141f;
  layout: row;
  @media (max-width: 900) { layout: column; background: #1f1414; }

  panel side {
    width: 260; padding: 16; gap: 8; background: #22223a; corner-radius: 10;
    @media (max-width: 900) { width: 100%; height: 160; }
    text title { text: "Settings"; font-size: 22; color: #e0e0ff; }
    button save { text: "Save"; tooltip: "Write the settings to disk"; height: 40; }
    button reset { text: "Reset"; tooltip: "Back to the defaults"; height: 40; }
  }
  panel body {
    flex-grow: 1; padding: 16; gap: 10; background: #1a1a2e; corner-radius: 10;
    @media (min-height: 700) { padding: 32; }
    checkbox vsync { text: "VSync"; checked: true; tooltip: "Sync to the display"; }
    slider volume { min: 0; max: 100; value: 40; width: 300; }
    toggle music { checked: false; }
    text-input name { placeholder: "Player name"; width: 300; }
    text note { text: "Resize the window to see the layout change."; color: #9090b0; }
  }
}
