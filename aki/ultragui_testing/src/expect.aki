// Shared by the tests: a failure counter that reports each failed check and
// lets the test run on, so one run lists everything that differs.

module ultragui_testing::expect;

import {eprintln} from akikit::logging;

pub struct Expect {
  var failures: u32 = 0
  var checks: u32 = 0

  pub fn Expect(): Expect => Expect {};

  // Records a check; prints `what` when it failed.
  pub fn that(var self&, ok: bool, what: str) {
    self.checks += 1;
    if (!ok) {
      self.failures += 1;
      eprintln(f"FAILED: {what}");
    }
  }

  // Bit-exact f32 comparison against a C++-recorded value.
  pub fn bits(var self&, v: f32, expected: u32, what: str) {
    let got = @bit_cast(u32, v);
    self.that(got == expected, f"{what}: got 0x{got:08x}, want 0x{expected:08x}");
  }

  pub fn eq_u32(var self&, got: u32, want: u32, what: str) {
    self.that(got == want, f"{what}: got {got}, want {want}");
  }

  // The exit code: 0 when every check passed.
  pub fn finish(self&): i32 {
    if (self.failures != 0) {
      eprintln(f"{self.failures} of {self.checks} checks failed");
      return 1;
    }
    return 0;
  }
}
