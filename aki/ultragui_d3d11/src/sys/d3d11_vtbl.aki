// Release of any COM object; the vtables of every interface begin with IUnknown's.
pub unsafe fn release<T>(object: *var T): u32 {
  unsafe {
    let u = object as *var Unknown;
    return ((*(*u).vtbl).release)(u);
  }
}

pub unsafe fn add_ref<T>(object: *var T): u32 {
  unsafe {
    let u = object as *var Unknown;
    return ((*(*u).vtbl).add_ref)(u);
  }
}
