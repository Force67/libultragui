// No C++ counterpart: the Direct3D 11 / DXGI declarations the D3D11 RHI,
// ugui_impl_dx11 and the shader compiler use, written by hand against the
// headers the C++ includes (the Windows SDK's, and DXVK-native's on Linux; they
// agree on every layout here). The C++ uses the C-style COM interface
// (CINTERFACE / COBJMACROS) so one call style covers both; so does this:
// every interface is a pointer to a struct whose first field is a pointer to a
// vtable of function pointers (sys::d3d11_vtbl). Constants keep the SDK's
// names without the D3D11_ prefix, as `kD3d11...`/`kDxgi...`.
//
// tests/d3d11_layout_test.aki checks every struct size and field offset, every
// constant and every vtable slot used against what the C headers say
// (tools/gen_d3d_layout.cc).
//
// A COM object is `ComObject`, an opaque pointee; `*var ComObject` is any
// interface pointer. HRESULT is i32; BOOL is i32.

module ultragui_d3d11::sys::d3d11;

pub extern type ComObject;

pub type Hresult = i32;

pub fn failed(hr: Hresult): bool => hr < 0;
pub fn succeeded(hr: Hresult): bool => hr >= 0;

pub extern struct Guid {
  pub var data1: u32
  pub var data2: u16
  pub var data3: u16
  pub var data4: [u8; 8]
}

// IID_ID3D11Texture2D, IID_IDXGIDevice, IID_IDXGIFactory
pub static let kIidTexture2d: Guid = Guid { data1: 0x6f15aaf2, data2: 0xd208, data3: 0x4e89,
  data4: [0x9a, 0xb4, 0x48, 0x95, 0x35, 0xd3, 0x4f, 0x9c] };
pub static let kIidDxgiDevice: Guid = Guid { data1: 0x54ec77fa, data2: 0x1377, data3: 0x44e6,
  data4: [0x8c, 0x32, 0x88, 0xfd, 0x5f, 0x44, 0xc8, 0x4c] };
pub static let kIidDxgiFactory: Guid = Guid { data1: 0x7b7166ec, data2: 0x21c7, data3: 0x44ae,
  data4: [0xb2, 0x1a, 0xc9, 0xae, 0x32, 0x1a, 0xe3, 0x69] };

