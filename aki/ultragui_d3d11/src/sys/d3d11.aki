pub comptime let kViewportAndScissorrectObjectCountPerPipeline: u32 = 16;

// --- Structs -----------------------------------------------------------------

pub extern struct DxgiSampleDesc {
  pub var count: u32
  pub var quality: u32
}

pub extern struct DxgiRational {
  pub var numerator: u32
  pub var denominator: u32
}

pub extern struct DxgiModeDesc {
  pub var width: u32
  pub var height: u32
  pub var refresh_rate: DxgiRational
  pub var format: u32
  pub var scanline_ordering: u32
  pub var scaling: u32
}

pub extern struct DxgiSwapChainDesc {
  pub var buffer_desc: DxgiModeDesc
  pub var sample_desc: DxgiSampleDesc
  pub var buffer_usage: u32
  pub var buffer_count: u32
  pub var output_window: *var u8
  pub var windowed: i32
  pub var swap_effect: u32
  pub var flags: u32
}

pub extern struct BufferDesc {
  pub var byte_width: u32
  pub var usage: u32
  pub var bind_flags: u32
  pub var cpu_access_flags: u32
  pub var misc_flags: u32
  pub var structure_byte_stride: u32
}

pub extern struct Texture2dDesc {
  pub var width: u32
  pub var height: u32
  pub var mip_levels: u32
  pub var array_size: u32
  pub var format: u32
  pub var sample_desc: DxgiSampleDesc
  pub var usage: u32
  pub var bind_flags: u32
  pub var cpu_access_flags: u32
  pub var misc_flags: u32
}

pub extern struct SubresourceData {
  pub var sys_mem: *const u8
  pub var sys_mem_pitch: u32
  pub var sys_mem_slice_pitch: u32
}

pub extern struct MappedSubresource {
  pub var data: *var u8
  pub var row_pitch: u32
  pub var depth_pitch: u32
}

// D3D11_SHADER_RESOURCE_VIEW_DESC: the union is as large as its largest member
// (4 u32); the Texture2D member uses the first two.
pub extern struct ShaderResourceViewDesc {
  pub var format: u32
  pub var view_dimension: u32
  pub var most_detailed_mip: u32
  pub var mip_levels: u32
  pub var pad0: u32
  pub var pad1: u32
}

// D3D11_RENDER_TARGET_VIEW_DESC: union of up to 3 u32; Texture2D uses MipSlice.
pub extern struct RenderTargetViewDesc {
  pub var format: u32
  pub var view_dimension: u32
  pub var mip_slice: u32
  pub var pad0: u32
  pub var pad1: u32
}

pub extern struct InputElementDesc {
  pub var semantic_name: *const c_char
  pub var semantic_index: u32
  pub var format: u32
  pub var input_slot: u32
  pub var aligned_byte_offset: u32
  pub var input_slot_class: u32
  pub var instance_data_step_rate: u32
}

pub extern struct RenderTargetBlendDesc {
  pub var blend_enable: i32
  pub var src_blend: u32
  pub var dest_blend: u32
  pub var blend_op: u32
  pub var src_blend_alpha: u32
  pub var dest_blend_alpha: u32
  pub var blend_op_alpha: u32
  pub var render_target_write_mask: u8
}

pub extern struct BlendDesc {
  pub var alpha_to_coverage_enable: i32
  pub var independent_blend_enable: i32
  pub var render_target: [RenderTargetBlendDesc; 8]
}

pub extern struct RasterizerDesc {
  pub var fill_mode: u32
  pub var cull_mode: u32
  pub var front_counter_clockwise: i32
  pub var depth_bias: i32
  pub var depth_bias_clamp: f32
  pub var slope_scaled_depth_bias: f32
  pub var depth_clip_enable: i32
  pub var scissor_enable: i32
  pub var multisample_enable: i32
  pub var antialiased_line_enable: i32
}

pub extern struct DepthStencilopDesc {
  pub var stencil_fail_op: u32
  pub var stencil_depth_fail_op: u32
  pub var stencil_pass_op: u32
  pub var stencil_func: u32
}

pub extern struct DepthStencilDesc {
  pub var depth_enable: i32
  pub var depth_write_mask: u32
  pub var depth_func: u32
  pub var stencil_enable: i32
  pub var stencil_read_mask: u8
  pub var stencil_write_mask: u8
  pub var front_face: DepthStencilopDesc
  pub var back_face: DepthStencilopDesc
}

pub extern struct SamplerDesc {
  pub var filter: u32
  pub var address_u: u32
  pub var address_v: u32
  pub var address_w: u32
  pub var mip_lod_bias: f32
  pub var max_anisotropy: u32
  pub var comparison_func: u32
  pub var border_color: [f32; 4]
  pub var min_lod: f32
  pub var max_lod: f32
}

pub extern struct Viewport {
  pub var top_left_x: f32
  pub var top_left_y: f32
  pub var width: f32
  pub var height: f32
  pub var min_depth: f32
  pub var max_depth: f32
}

// D3D11_RECT is RECT: four LONGs (32-bit), left/top/right/bottom.
pub extern struct D3dRect {
  pub var left: i32
  pub var top: i32
  pub var right: i32
  pub var bottom: i32
}
